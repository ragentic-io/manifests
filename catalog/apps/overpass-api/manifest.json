        "specification": {
          "document": {
            "externalDocs": {
              "description": "Overpass API HTTP request documentation",
              "url": "https://dev.overpass-api.de/command_line.html"
            },
            "info": {
              "description": "Community-maintained description of the main public Overpass instance. This specification covers the interpreter endpoint when a query requests JSON output with the `[out:json]` directive. Query results vary with the query and its output modifiers; follow the shared instance's fair-use policy.",
              "title": "Overpass API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/interpreter": {
                "get": {
                  "description": "Supply the Overpass QL program in `data`. Include `[out:json]` in the program for the JSON response documented here.",
                  "operationId": "runQueryGet",
                  "parameters": [
                    {
                      "description": "Overpass QL program; request JSON output with `[out:json]`.",
                      "example": "[out:json];node(50.746,7.152,50.747,7.153);out;",
                      "in": "query",
                      "name": "data",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "properties": {
                              "elements": {
                                "description": "Element fields vary by query and output modifiers.",
                                "items": {
                                  "additionalProperties": true,
                                  "type": "object"
                                },
                                "type": "array"
                              },
                              "generator": {
                                "type": "string"
                              },
                              "osm3s": {
                                "properties": {
                                  "copyright": {
                                    "type": "string"
                                  },
                                  "timestamp_osm_base": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "timestamp_osm_base",
                                  "copyright"
                                ],
                                "type": "object"
                              },
                              "version": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "version",
                              "generator",
                              "osm3s",
                              "elements"
                            ],
                            "type": "object"
                          }
                        }
                      },
                      "description": "Query result in Overpass JSON format."
                    },
                    "302": {
                      "description": "Redirect used by the permanent ID feature."
                    },
                    "400": {
                      "content": {
                        "text/html": {
                          "schema": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Invalid query; the response body is an HTML error document."
                    },
                    "429": {
                      "description": "Request rejected by the fair-use policy."
                    },
                    "504": {
                      "description": "Query timed out or the server is too busy to complete it."
                    }
                  },
                  "summary": "Run an Overpass query with GET"
                },
                "post": {
                  "description": "Submit the Overpass QL program as the `data` form field. Include `[out:json]` in the program for the JSON response documented here.",
                  "operationId": "runQueryPost",
                  "requestBody": {
                    "content": {
                      "application/x-www-form-urlencoded": {
                        "schema": {
                          "properties": {
                            "data": {
                              "description": "Overpass QL program; request JSON output with `[out:json]`.",
                              "example": "[out:json];node(50.746,7.152,50.747,7.153);out;",
                              "type": "string"
                            }
                          },
                          "required": [
                            "data"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "properties": {
                              "elements": {
                                "description": "Element fields vary by query and output modifiers.",
                                "items": {
                                  "additionalProperties": true,
                                  "type": "object"
                                },
                                "type": "array"
                              },
                              "generator": {
                                "type": "string"
                              },
                              "osm3s": {
                                "properties": {
                                  "copyright": {
                                    "type": "string"
