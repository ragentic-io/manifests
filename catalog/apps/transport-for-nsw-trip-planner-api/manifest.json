  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "transport-for-nsw-trip-planner-api"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.transport.nsw.gov.au/v1/tp",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "coordOutputFormat": {
                  "description": "Coordinate output format documented for Trip Planner API calls.",
                  "in": "query",
                  "name": "coordOutputFormat",
                  "required": true,
                  "schema": {
                    "enum": [
                      "EPSG:4326"
                    ],
                    "type": "string"
                  }
                },
                "outputFormat": {
                  "description": "The provider's JSON response format.",
                  "in": "query",
                  "name": "outputFormat",
                  "required": true,
                  "schema": {
                    "enum": [
                      "rapidJSON"
                    ],
                    "type": "string"
                  }
                }
              },
              "schemas": {
                "DepartureResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "stopEvents": {
                      "items": {
                        "additionalProperties": true,
                        "description": "A departure event for a stop.",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "Location": {
                  "additionalProperties": true,
                  "properties": {
                    "coord": {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "id": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "isBest": {
                      "type": "boolean"
                    },
                    "matchQuality": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "LocationsResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "locations": {
                      "items": {
                        "$ref": "#/components/schemas/Location"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "ServiceAlertsResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "infos": {
                      "additionalProperties": true,
                      "properties": {
                        "current": {
                          "items": {
                            "additionalProperties": true,
                            "properties": {
                              "affected": {
                                "additionalProperties": true,
                                "type": "object"
                              },
                              "subtitle": {
                                "type": "string"
                              },
                              "timestamps": {
                                "additionalProperties": true,
                                "type": "object"
                              },
                              "url": {
                                "format": "uri",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "TripResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "journeys": {
                      "items": {
                        "additionalProperties": true,
                        "description": "A journey with itinerary legs.",
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              },
              "securitySchemes": {
                "apiKey": {
                  "description": "Send the header as `Authorization: apikey <key>`.",
                  "in": "header",
                  "name": "Authorization",
                  "type": "apiKey"
                }
              }
            },
            "info": {
              "description": "Focused community-maintained specification for the five documented Trip Planner operations: stop search, trip planning, departures, service alerts, and nearby locations. A registered API key is required in the `Authorization` header using the `apikey <key>` value format. The provider documents a default Bronze account plan; account limits can change. Other Transport for NSW APIs and GTFS feeds are not covered here.",
              "externalDocs": {
                "description": "Trip Planner API technical manual, version 3.3",
                "url": "https://opendata.transport.nsw.gov.au/sites/default/files/2026-04/trip-planner-api-manual-opendataproduction-v3.3.pdf"
              },
              "title": "Transport for NSW Trip Planner API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/add_info": {
                "get": {
                  "description": "Returns service alerts and information for the transport network.",
                  "operationId": "getServiceAlerts",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/outputFormat"
                    },
                    {
                      "$ref": "#/components/parameters/coordOutputFormat"
                    },
                    {
                      "description": "Filter date in DD-MM-YYYY format.",
                      "in": "query",
                      "name": "filterDateValid",
                      "required": false,
                      "schema": {
                        "pattern": "^\\\\d{2}-\\\\d{2}-\\\\d{4}$",
                        "type": "string"
                      }
                    },
                    {
                      "description": "Filter by publication status; the manual uses `current` for active alerts.",
                      "in": "query",
                      "name": "filterPublicationStatus",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Restrict alerts to the supplied stop identifier.",
                      "in": "query",
                      "name": "itdLPxx_selStop",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/ServiceAlertsResponse"
                          }
                        }
                      },
                      "description": "Service alert information."
                    },
                    "401": {
                      "description": "The API key is missing or invalid, or the account quota has been exceeded."
                    },
                    "403": {
                      "description": "The request was refused, including when the rate limit is exceeded."
                    }
                  },
                  "summary": "Get public transport service alerts",
                  "tags": [
                    "Trip planning"
                  ]
                }
              },
              "/coord": {
                "get": {
                  "description": "Finds transport stops, places of interest, or Opal resellers near a coordinate.",
                  "operationId": "findNearbyLocations",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/outputFormat"
                    },
                    {
                      "$ref": "#/components/parameters/coordOutputFormat"
                    },
                    {
                      "description": "Coordinate string in EPSG:4326; the manual's example orders longitude before latitude.",
                      "in": "query",
                      "name": "coord",
                      "required": true,
                      "schema": {
                        "example": "151.206290:-33.884080:EPSG:4326",
                        "type": "string"
                      }
                    },
                    {
                      "description": "Location type; the manual uses `GIS_POINT` in its example.",
                      "in": "query",
                      "name": "type_1",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Search radius in metres.",
                      "in": "query",
                      "name": "radius_1",
                      "required": true,
                      "schema": {
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Optional location filter flag used in the provider's example.",
                      "in": "query",
                      "name": "inclFilter",
                      "required": false,
                      "schema": {
                        "enum": [
                          1
                        ],
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Optional draw class filter; the manual uses 74 to return Opal resellers.",
                      "in": "query",
                      "name": "inclDrawClasses_1",
                      "required": false,
                      "schema": {
                        "type": "integer"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/LocationsResponse"
                          }
                        }
                      },
                      "description": "Locations near the supplied coordinate."
                    },
                    "401": {
                      "description": "The API key is missing or invalid, or the account quota has been exceeded."
                    },
                    "403": {
                      "description": "The request was refused, including when the rate limit is exceeded."
                    }
                  },
                  "summary": "Find locations near a coordinate",
                  "tags": [
                    "Trip planning"
                  ]
                }
              },
              "/departure_mon": {
                "get": {
                  "description": "Returns upcoming departures for a stop or platform.",
                  "operationId": "getDepartures",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/outputFormat"
                    },
                    {
                      "$ref": "#/components/parameters/coordOutputFormat"
                    },
                    {
                      "description": "Mode value used by the provider's departure example.",
                      "in": "query",
                      "name": "mode",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Departure location type, such as `stop`.",
                      "in": "query",
                      "name": "type_dm",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Stop or platform identifier.",
                      "in": "query",
                      "name": "name_dm",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Departure or arrival mode.",
                      "in": "query",
                      "name": "depArrMacro",
                      "required": true,
                      "schema": {
                        "enum": [
                          "dep",
                          "arr"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Date formatted as YYYYMMDD.",
                      "in": "query",
                      "name": "itdDate",
                      "required": true,
                      "schema": {
                        "pattern": "^\\\\d{8}$",
                        "type": "string"
                      }
                    },
