                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "status": {
                          "enum": [
                            "active",
                            "access_restricted"
                          ],
                          "type": "string"
                        },
                        "usage": {
                          "properties": {
                            "daily_average": {
                              "type": "number"
                            },
                            "days_elapsed": {
                              "type": "integer"
                            },
                            "days_remaining": {
                              "type": "integer"
                            },
                            "requests": {
                              "type": "integer"
                            },
