                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "RatesResponse": {
                  "properties": {
                    "base": {
                      "description": "Three-letter code for the base currency.",
                      "type": "string"
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "license": {
                      "type": "string"
                    },
                    "rates": {
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Currency codes mapped to exchange rates relative to the base.",
                      "type": "object"
                    },
                    "timestamp": {
                      "description": "UNIX timestamp in UTC seconds.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "UsageResponse": {
                  "properties": {
                    "data": {
                      "properties": {
                        "app_id": {
                          "type": "string"
