                        "type": "string"
                      }
                    },
                    {
                      "description": "Geography predicate, such as `state:*`; supported geographies vary by dataset and year.",
                      "in": "query",
                      "name": "for",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Optional parent-geography predicate used with `for`.",
