              "/data/{year}/acs/acs1": {
                "get": {
                  "description": "Queries variables and geographies for a selected ACS 1-year vintage. Use only variables and geography predicates listed for that dataset in the Census discovery tool.",
                  "operationId": "queryAcsOneYearData",
                  "parameters": [
                    {
                      "description": "Data year, for example 2023.",
                      "in": "path",
