                              "first_name": "Renard",
                              "from_city": "Arlington",
                              "from_company": "Defense Corp",
                              "from_first_name": "Jane",
                              "from_last_name": "Smith",
                              "from_state": "VA",
                              "from_street_address": "1400 Defense Pentagon",
                              "from_zip_code": "20301",
                              "last_name": "Plastique",
                              "mail": "1723208643631x895868956464644100",
                              "phone": "555-1234",
                              "send_date": "2025-08-15",
                              "state": "DC",
                              "street_address_1": "1600 Pennsylvania Avenue NW",
                              "zip_code": "20500"
                            }
                          }
                        },
                        "schema": {
                          "properties": {
                            "blind_send": {
                              "description": "**Blind Send**: Indicates if the mail should be sent without revealing the sender's information to the recipient.\n- Example: `false`\n",
                              "type": "boolean"
                            },
                            "city": {
                              "description": "**Recipient's City**: The city where the recipient resides.\n- Example: `Washington`\n",
                              "type": "string"
                            },
                            "company": {
                              "description": "**Recipient's Company**: The name of the recipient's company, if applicable.\n- Example: `Persona Technologies Ltd`\n",
                              "type": "string"
                            },
                            "custom_1": {
                              "description": "**Custom Field 1**: A customizable field for additional metadata or personalization.\n- Example: `Additional Metadata`\n",
                              "type": "string"
                            },
                            "custom_2": {
                              "description": "**Custom Field 2**: A second customizable field for additional data.\n- Example: `Custom Field 2`\n",
                              "type": "string"
                            },
                            "custom_3": {
                              "description": "**Custom Field 3**: A third customizable field for additional data.\n- Example: `Custom Field 3`\n",
                              "type": "string"
                            },
                            "custom_4": {
                              "description": "**Custom Field 4**: A fourth customizable field for additional data.\n- Example: `Custom Field 4`\n",
                              "type": "string"
                            },
                            "custom_5": {
                              "description": "**Custom Field 5**: A fifth customizable field for more additional data.\n- Example: `More custom fields`\n",
                              "type": "string"
                            },
                            "email": {
                              "description": "**Recipient's Email Address**: Email address of the recipient for any electronic notifications or confirmations.\n- Example: `rendolf.jones@slart.com`\n",
                              "type": "string"
                            },
                            "first_name": {
                              "description": "**Recipient's First Name**: The first name of the recipient. Used for personalization in the mail design.\n- Example: `Renard`\n",
                              "type": "string"
                            },
                            "from_city": {
                              "description": "**Sender's City**: The city where the sender resides.\n- Example: `Arlington`\n",
                              "type": "string"
                            },
                            "from_company": {
                              "description": "**Sender's Company**: The company name of the sender.\n- Example: `Defense Corp`\n",
                              "type": "string"
                            },
                            "from_first_name": {
                              "description": "**Sender's First Name**: The first name of the sender.\n- Example: `Jane`\n",
                              "type": "string"
                            },
                            "from_last_name": {
                              "description": "**Sender's Last Name**: The last name of the sender.\n- Example: `Smith`\n",
                              "type": "string"
                            },
                            "from_state": {
                              "description": "**Sender's State**: The state or province where the sender resides.\n- Example: `VA`\n",
                              "type": "string"
                            },
                            "from_street_address": {
                              "description": "**Sender's Street Address**: The street address of the sender.\n- Example: `1400 Defense Pentagon`\n",
                              "type": "string"
                            },
                            "from_zip_code": {
                              "description": "**Sender's ZIP Code**: The ZIP or postal code of the sender's address.\n- Example: `20301`\n",
                              "type": "string"
                            },
                            "last_name": {
                              "description": "**Recipient's Last Name**: The last name of the recipient. Used for personalization in the mail design.\n- Example: `Plastique`\n",
                              "type": "string"
                            },
                            "mail": {
                              "description": "**Mail Design ID**: The unique identifier for the mail design to be used. This specifies which design template will be applied to the one-off mail request.\n- Example: `1723208113631x895868956464644100`\n",
                              "type": "string"
                            },
                            "phone": {
                              "description": "**Recipient's Phone Number**: Contact number of the recipient.\n- Example: `555-1234`\n",
                              "type": "string"
                            },
                            "send_date": {
                              "description": "**Send Date**: The date on which the mail request is scheduled to be sent.\n- Example: `2025-08-15`\n",
                              "format": "date",
                              "type": "string"
                            },
                            "state": {
                              "description": "**Recipient's State**: The state or province where the recipient resides.\n- Example: `DC`\n",
                              "type": "string"
                            },
                            "street_address_1": {
                              "description": "**Recipient's Street Address**: The primary street address of the recipient.\n- Example: `1600 Pennsylvania Avenue NW`\n",
                              "type": "string"
                            },
                            "zip_code": {
                              "description": "**Recipient's ZIP Code**: The ZIP or postal code of the recipient's address.\n- Example: `20500`\n",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
