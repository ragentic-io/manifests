  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "bureau-of-labor-statistics"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.bls.gov",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "latest": {
                  "description": "Set to true to return the most recent data point only.",
                  "in": "query",
                  "name": "latest",
                  "required": false,
                  "schema": {
                    "type": "boolean"
                  }
                },
                "seriesId": {
                  "description": "BLS series identifier. IDs use uppercase letters and may contain digits, underscores, hyphens, and hash characters.",
                  "in": "path",
                  "name": "seriesId",
                  "required": true,
                  "schema": {
                    "pattern": "^[A-Z0-9_#-]+$",
                    "type": "string"
                  }
                }
              },
              "schemas": {
                "Aspect": {
                  "properties": {
                    "footnotes": {
                      "items": {
                        "$ref": "#/components/schemas/Footnote"
                      },
                      "type": "array"
                    },
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "DataPoint": {
                  "properties": {
                    "aspects": {
                      "items": {
                        "$ref": "#/components/schemas/Aspect"
                      },
                      "type": "array"
                    },
                    "footnotes": {
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "$ref": "#/components/schemas/Footnote"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "latest": {
                      "type": "string"
                    },
                    "period": {
                      "type": "string"
                    },
                    "periodName": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "year": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "Footnote": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "PopularSeriesResponse": {
                  "properties": {
                    "Results": {
                      "properties": {
                        "series": {
                          "items": {
                            "properties": {
                              "seriesID": {
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "message": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "responseTime": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "Results"
                  ],
                  "type": "object"
                },
                "SeriesData": {
                  "properties": {
                    "catalog": {
                      "additionalProperties": true,
                      "description": "BLS series metadata; fields vary by series.",
                      "type": "object"
                    },
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/DataPoint"
                      },
                      "type": "array"
                    },
                    "seriesID": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "seriesID",
                    "data"
                  ],
                  "type": "object"
                },
                "SeriesResults": {
                  "properties": {
                    "series": {
                      "items": {
                        "$ref": "#/components/schemas/SeriesData"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "series"
                  ],
                  "type": "object"
                },
                "Survey": {
                  "properties": {
                    "allowsNetChange": {
                      "type": "string"
                    },
                    "allowsPercentChange": {
                      "type": "string"
                    },
                    "hasAnnualAverages": {
                      "type": "string"
                    },
                    "survey_abbreviation": {
                      "type": "string"
                    },
                    "survey_name": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "SurveyResponse": {
                  "properties": {
                    "Results": {
                      "properties": {
                        "survey": {
                          "items": {
                            "$ref": "#/components/schemas/Survey"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "message": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "responseTime": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "Results"
                  ],
                  "type": "object"
                },
                "TimeSeriesResponse": {
                  "properties": {
                    "Results": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SeriesResults"
                        },
                        {
                          "items": {
                            "$ref": "#/components/schemas/SeriesResults"
                          },
                          "type": "array"
                        }
                      ]
                    },
                    "message": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "responseTime": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "Results"
                  ],
                  "type": "object"
                },
                "V1TimeSeriesRequest": {
                  "description": "Supply startyear and endyear together to select a period.",
                  "properties": {
                    "endyear": {
                      "$ref": "#/components/schemas/Year"
                    },
                    "seriesid": {
                      "description": "One or more BLS series identifiers.",
                      "items": {
                        "pattern": "^[A-Z0-9_#-]+$",
                        "type": "string"
                      },
                      "maxItems": 25,
                      "minItems": 1,
                      "type": "array"
                    },
                    "startyear": {
                      "$ref": "#/components/schemas/Year"
                    }
                  },
                  "required": [
                    "seriesid"
                  ],
                  "type": "object"
                },
                "V2TimeSeriesRequest": {
                  "description": "Supply startyear and endyear together to select a period.",
                  "properties": {
                    "annualaverage": {
                      "description": "Include annual averages where available.",
                      "type": "boolean"
                    },
                    "aspects": {
                      "description": "Include documented aspects data where available.",
                      "type": "boolean"
                    },
                    "calculations": {
                      "description": "Include net and percent calculations where available.",
                      "type": "boolean"
                    },
                    "catalog": {
                      "description": "Include series description information when available.",
                      "type": "boolean"
                    },
                    "endyear": {
                      "$ref": "#/components/schemas/Year"
                    },
                    "registrationkey": {
                      "description": "BLS registration key for expanded access and optional data.",
                      "type": "string"
                    },
                    "seriesid": {
                      "description": "One or more BLS series identifiers.",
                      "items": {
                        "pattern": "^[A-Z0-9_#-]+$",
                        "type": "string"
                      },
                      "maxItems": 50,
                      "minItems": 1,
                      "type": "array"
                    },
                    "startyear": {
                      "$ref": "#/components/schemas/Year"
                    }
                  },
                  "required": [
                    "seriesid"
                  ],
                  "type": "object"
                },
                "Year": {
                  "description": "Four-digit year.",
                  "pattern": "^\\d{4}$",
                  "type": "string"
                }
              }
            },
            "info": {
              "description": "Community-maintained specification for the documented JSON time-series, survey, and popular-series signatures. BLS API version 1.0 is open without registration. Version 2.0 documents higher limits and additional features; registration keys are described by BLS for those features. Excel output signatures are outside this specification.",
              "externalDocs": {
                "description": "BLS Public Data API signatures, version 2.0",
                "url": "https://www.bls.gov/developers/api_signature_v2.htm"
              },
              "title": "BLS Public Data API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/publicAPI/v1/timeseries/data/": {
                "post": {
                  "description": "Accepts up to 25 series IDs. Include both startyear and endyear to request a selected period of up to 10 years; without them, the API returns the default recent period.",
                  "operationId": "queryV1TimeSeries",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/V1TimeSeriesRequest"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/TimeSeriesResponse"
                          }
                        }
                      },
                      "description": "BLS time-series response."
                    }
                  },
                  "summary": "Query one or more time series"
                }
              },
              "/publicAPI/v1/timeseries/data/{seriesId}": {
                "get": {
                  "description": "Returns up to the past three years of data for a series.",
                  "operationId": "getV1TimeSeries",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/seriesId"
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/TimeSeriesResponse"
                          }
                        }
                      },
                      "description": "BLS time-series response."
                    }
                  },
                  "summary": "Get a single time series"
                }
              },
              "/publicAPI/v2/surveys": {
                "get": {
                  "operationId": "listSurveys",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/SurveyResponse"
                          }
                        }
                      },
                      "description": "BLS survey list response."
                    }
                  },
                  "summary": "List BLS surveys"
                }
              },
              "/publicAPI/v2/surveys/{surveyAbbreviation}": {
                "get": {
                  "operationId": "getSurvey",
                  "parameters": [
                    {
                      "description": "BLS survey abbreviation, such as TU.",
                      "in": "path",
                      "name": "surveyAbbreviation",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/SurveyResponse"
                          }
                        }
                      },
                      "description": "BLS survey details response."
                    }
                  },
                  "summary": "Get survey details"
                }
              },
              "/publicAPI/v2/timeseries/data/": {
                "post": {
                  "description": "Accepts up to 50 series IDs. Include startyear and endyear to select a period of up to 20 years. BLS documents registration keys for the higher limits and optional catalog, calculation, annual-average, and aspect data.",
                  "operationId": "queryV2TimeSeries",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/V2TimeSeriesRequest"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/TimeSeriesResponse"
                          }
                        }
                      },
                      "description": "BLS time-series response."
                    }
                  },
                  "summary": "Query one or more time series"
                }
              },
              "/publicAPI/v2/timeseries/data/{seriesId}": {
                "get": {
                  "description": "Returns data for one series. Set latest to true to request only its most recent data point.",
                  "operationId": "getV2TimeSeries",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/seriesId"
                    },
                    {
                      "$ref": "#/components/parameters/latest"
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/TimeSeriesResponse"
                          }
                        }
                      },
                      "description": "BLS time-series response."
                    }
                  },
                  "summary": "Get a single time series"
                }
              },
              "/publicAPI/v2/timeseries/popular": {
                "get": {
                  "description": "Returns the 25 most popular series, optionally for one survey.",
                  "operationId": "listPopularSeries",
                  "parameters": [
                    {
                      "description": "Survey abbreviation used to filter popular series.",
