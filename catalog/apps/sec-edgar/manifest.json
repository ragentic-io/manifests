                "get": {
                  "description": "Returns the most recently filed fact for each reporting entity that best matches the requested annual, quarterly, or instantaneous period.",
                  "operationId": "getXbrlFrame",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/UserAgent"
