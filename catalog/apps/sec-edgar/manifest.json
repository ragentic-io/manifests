          "document": {
            "components": {
              "parameters": {
                "Cik": {
                  "description": "Ten-digit Central Index Key, including leading zeroes.",
                  "in": "path",
                  "name": "cik",
                  "required": true,
                  "schema": {
                    "pattern": "^\\d{10}$",
                    "type": "string"
                  }
                },
                "UserAgent": {
                  "description": "Identify the organization or application and include a contact address, as required by the [SEC developer guidance](https://www.sec.gov/about/developer-resources).",
                  "in": "header",
                  "name": "User-Agent",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              },
              "responses": {
                "JsonObject": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "additionalProperties": true,
                        "type": "object"
                      }
                    }
                  },
                  "description": "JSON response; exact fields vary by endpoint and reporting entity."
                }
              }
            },
            "info": {
              "description": "Focused community-maintained specification for the SEC's public EDGAR submissions and XBRL data APIs. The SEC documents these JSON endpoints as requiring no authentication or API key. Automated clients must identify themselves with a descriptive User-Agent and follow the SEC's fair-access policy, including its 10-requests-per-second limit.",
              "externalDocs": {
                "description": "SEC EDGAR API documentation",
                "url": "https://www.sec.gov/search-filings/edgar-application-programming-interfaces"
              },
