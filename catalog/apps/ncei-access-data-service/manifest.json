            "paths": {
              "/v1": {
                "get": {
                  "description": "Some request parameters and output fields vary by dataset. Supported output formats are CSV, SSV, JSON, PDF, and NetCDF.",
                  "operationId": "getDatasetData",
                  "parameters": [
                    {
                      "description": "Selects the dataset to query. Not all NCEI datasets are available through this service.",
                      "in": "query",
                      "name": "dataset",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Comma-separated station identifiers used to subset results.",
                      "explode": false,
                      "in": "query",
                      "name": "stations",
                      "schema": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "style": "form"
                    },
                    {
                      "description": "Optional ISO 8601 date or date-time lower bound. Must precede endDate when both are supplied. Encode a plus sign in a time-zone offset as %2B.",
                      "in": "query",
                      "name": "startDate",
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Optional ISO 8601 date or date-time upper bound. Encode a plus sign in a time-zone offset as %2B.",
                      "in": "query",
                      "name": "endDate",
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Comma-separated, case-sensitive data type names; available names depend on the dataset.",
                      "explode": false,
                      "in": "query",
                      "name": "dataTypes",
                      "schema": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "style": "form"
                    },
                    {
                      "description": "Geographic bounds in north,west,south,east order. Latitude values range from -90 to 90 and longitude values from -180 to 180.",
                      "explode": false,
                      "in": "query",
                      "name": "bbox",
                      "schema": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 4,
                        "minItems": 4,
                        "type": "array"
                      },
                      "style": "form"
                    },
                    {
                      "description": "Requested response format. Some formats may ignore selected data types.",
                      "in": "query",
                      "name": "format",
                      "schema": {
                        "default": "csv",
                        "enum": [
                          "csv",
                          "ssv",
                          "json",
                          "pdf",
                          "netcdf"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Comma-separated option:value pairs; the documented station and attribute options can also be sent as individual parameters.",
                      "in": "query",
                      "name": "options",
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Include data type attributes when available; defaults to false or 0.",
                      "in": "query",
                      "name": "includeAttributes",
                      "schema": {
                        "default": false,
                        "oneOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "enum": [
                              0,
                              1
                            ],
                            "type": "integer"
                          }
                        ]
                      }
                    },
                    {
                      "description": "Include station names when available; defaults to false or 0.",
                      "in": "query",
                      "name": "includeStationName",
                      "schema": {
                        "default": false,
                        "oneOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "enum": [
                              0,
                              1
                            ],
                            "type": "integer"
                          }
                        ]
                      }
                    },
                    {
                      "description": "Include station locations when available; defaults to false or 0.",
                      "in": "query",
                      "name": "includeStationLocation",
                      "schema": {
                        "default": false,
                        "oneOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "enum": [
                              0,
                              1
                            ],
                            "type": "integer"
                          }
                        ]
                      }
                    },
                    {
                      "description": "Convert supported values to metric or standard units.",
                      "in": "query",
                      "name": "units",
                      "schema": {
                        "enum": [
                          "metric",
                          "standard"
                        ],
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "*/*": {
                          "schema": {}
                        },
                        "application/json": {
                          "schema": {
                            "items": {
                              "$ref": "#/components/schemas/DataRecord"
                            },
                            "type": "array"
                          }
                        }
                      },
                      "description": "Dataset data. The format and record fields depend on the selected dataset and format parameter."
                    },
                    "400": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/BadRequest"
                          }
                        }
                      },
                      "description": "Malformed request; the response includes a JSON error and may include field-level details."
                    },
                    "500": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Error"
                          }
                        }
                      },
                      "description": "Internal service error."
                    }
                  },
                  "summary": "Retrieve data from a dataset"
                }
              }
            },
            "servers": [
