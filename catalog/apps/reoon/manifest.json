  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "reoon"
    },
    "spec": {
      "base": {
        "endpoint": "https://emailverifier.reoon.com/api/v1",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "AccountBalance": {
                  "additionalProperties": true,
                  "properties": {
                    "api_status": {
                      "type": "string"
                    },
                    "remaining_daily_credits": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "remaining_instant_credits": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "status": {
                      "const": "success",
                      "type": "string"
                    }
                  },
                  "required": [
                    "api_status",
                    "remaining_daily_credits",
                    "remaining_instant_credits",
                    "status"
                  ],
                  "type": "object"
                },
                "ApiError": {
                  "additionalProperties": true,
                  "properties": {
                    "reason": {
                      "description": "Human-readable description of the API error.",
                      "type": "string"
                    },
                    "status": {
                      "const": "error",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "type": "object"
                },
                "BulkEmailVerificationResult": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EmailVerificationResult"
                    },
                    {
                      "properties": {
                        "status": {
                          "enum": [
                            "safe",
                            "invalid",
                            "disabled",
                            "disposable",
                            "inbox_full",
                            "catch_all",
                            "role_account",
                            "spamtrap",
                            "unknown"
                          ],
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "BulkTaskResult": {
                  "additionalProperties": true,
                  "properties": {
                    "count_checked": {
                      "type": "integer"
                    },
                    "count_total": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "progress_percentage": {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "number"
                    },
                    "results": {
                      "description": "Reoon's prose describes an array, while its worked example is an object keyed by email address. Both documented shapes are accepted.",
                      "oneOf": [
                        {
                          "items": {
                            "$ref": "#/components/schemas/BulkEmailVerificationResult"
                          },
                          "type": "array"
                        },
                        {
                          "additionalProperties": {
                            "$ref": "#/components/schemas/BulkEmailVerificationResult"
                          },
                          "type": "object"
                        }
                      ]
                    },
                    "status": {
                      "description": "Known values include waiting, running, completed, file_not_found, and file_loading_error; other values may be returned.",
                      "type": "string"
                    },
                    "task_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "type": "object"
                },
                "CreateBulkTaskRequest": {
                  "properties": {
                    "emails": {
                      "description": "Email addresses to verify. Malformed addresses are rejected and included in count_rejected_emails rather than processed.",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 50000,
                      "type": "array"
                    },
                    "key": {
                      "description": "Active Reoon API key.",
                      "format": "password",
                      "type": "string",
                      "writeOnly": true
                    },
                    "name": {
                      "description": "Optional task name, up to 25 characters.",
                      "maxLength": 25,
                      "type": "string"
                    }
                  },
                  "required": [
                    "emails",
                    "key"
                  ],
                  "type": "object"
                },
                "CreateBulkTaskResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "count_duplicates_removed": {
                      "type": "integer"
                    },
                    "count_processing": {
                      "type": "integer"
                    },
                    "count_rejected_emails": {
                      "type": "integer"
                    },
                    "count_submitted": {
                      "type": "integer"
                    },
                    "status": {
                      "const": "success",
                      "type": "string"
                    },
                    "task_id": {
                      "description": "Unique ID to use when retrieving task results.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "status",
                    "task_id",
                    "count_submitted",
                    "count_duplicates_removed",
                    "count_rejected_emails",
                    "count_processing"
                  ],
                  "type": "object"
                },
                "EmailVerificationResult": {
                  "additionalProperties": true,
                  "description": "Fields differ by verification mode. Quick status values are valid, invalid, disposable, and spamtrap. Power status values are safe, invalid, disabled, disposable, inbox_full, catch_all, role_account, spamtrap, and unknown.",
                  "properties": {
                    "can_connect_smtp": {
                      "type": "boolean"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "has_inbox_full": {
                      "type": "boolean"
                    },
                    "is_catch_all": {
                      "type": "boolean"
                    },
                    "is_deliverable": {
                      "type": "boolean"
                    },
                    "is_disabled": {
                      "type": "boolean"
                    },
                    "is_disposable": {
                      "type": "boolean"
                    },
                    "is_free_email": {
                      "type": "boolean"
                    },
                    "is_role_account": {
                      "type": "boolean"
                    },
                    "is_safe_to_send": {
                      "type": "boolean"
                    },
                    "is_spamtrap": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "enum": [
                            "None"
                          ],
                          "type": "string"
                        }
                      ]
                    },
                    "is_valid_syntax": {
                      "type": "boolean"
                    },
                    "mx_accepts_mail": {
                      "type": "boolean"
                    },
                    "mx_records": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "overall_score": {
                      "description": "Power mode score out of 100.",
                      "maximum": 100,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "valid",
                        "invalid",
                        "disposable",
                        "spamtrap",
                        "safe",
                        "disabled",
                        "inbox_full",
                        "catch_all",
                        "role_account",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "verification_mode": {
                      "enum": [
                        "quick",
                        "power"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "email",
                    "status"
                  ],
                  "type": "object"
                },
                "PowerEmailVerificationResult": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EmailVerificationResult"
                    },
                    {
                      "properties": {
                        "status": {
                          "enum": [
                            "safe",
                            "invalid",
                            "disabled",
                            "disposable",
                            "inbox_full",
                            "catch_all",
                            "role_account",
                            "spamtrap",
                            "unknown"
                          ],
                          "type": "string"
                        },
                        "verification_mode": {
                          "const": "power",
                          "type": "string"
                        }
                      },
                      "required": [
                        "verification_mode"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "QuickEmailVerificationResult": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EmailVerificationResult"
                    },
                    {
                      "properties": {
                        "status": {
                          "enum": [
                            "valid",
                            "invalid",
                            "disposable",
                            "spamtrap"
                          ],
                          "type": "string"
                        },
                        "verification_mode": {
                          "const": "quick",
                          "type": "string"
                        }
                      },
                      "required": [
                        "verification_mode"
                      ],
                      "type": "object"
                    }
                  ]
                }
              },
              "securitySchemes": {
                "ReoonApiKey": {
                  "description": "Used by GET operations. Bulk task creation instead requires `key` in its JSON request body.",
                  "in": "query",
                  "name": "key",
                  "type": "apiKey"
                }
              }
            },
            "externalDocs": {
              "description": "Official Reoon Email Verifier API documentation",
              "url": "https://www.reoon.com/articles/api-documentation-of-reoon-email-verifier/"
            },
            "info": {
              "description": "OpenAPI description of Reoon Email Verifier's documented API v1.\nThe API key is sent in the query string for GET operations and in the JSON\nbody when creating a bulk task, as required by Reoon's API.",
              "title": "Reoon Email Verifier API",
              "version": "1.0.0"
            },
            "openapi": "3.2.1",
            "paths": {
              "/check-account-balance/": {
                "get": {
                  "description": "Returns the account's API status and remaining daily and instant credits.",
                  "operationId": "checkAccountBalance",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "example": {
                            "api_status": "active",
                            "remaining_daily_credits": 150,
                            "remaining_instant_credits": 5000,
                            "status": "success"
                          },
                          "schema": {
                            "$ref": "#/components/schemas/AccountBalance"
                          }
                        }
                      },
                      "description": "Current account balance."
                    }
                  },
                  "security": [
                    {
                      "ReoonApiKey": []
                    }
                  ],
                  "summary": "Check remaining credits",
                  "tags": [
                    "Account"
                  ]
                }
              },
              "/create-bulk-verification-task/": {
                "post": {
                  "description": "Submits up to 50,000 email addresses for asynchronous verification in power mode. Reoon removes duplicate addresses before processing. The API key must be included in the JSON body.",
                  "operationId": "createBulkVerificationTask",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "example": {
                          "emails": [
                            "user@example.com",
                            "person@example.net"
                          ],
                          "key": "YOUR_API_KEY",
                          "name": "Spring leads"
                        },
                        "schema": {
                          "$ref": "#/components/schemas/CreateBulkTaskRequest"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "201": {
                      "content": {
                        "application/json": {
                          "example": {
                            "count_duplicates_removed": 0,
                            "count_processing": 2,
                            "count_rejected_emails": 0,
                            "count_submitted": 2,
                            "status": "success",
                            "task_id": 40676
                          },
                          "schema": {
                            "$ref": "#/components/schemas/CreateBulkTaskResponse"
                          }
                        }
                      },
                      "description": "Bulk task created."
                    },
                    "default": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/ApiError"
                          }
                        }
                      },
                      "description": "Reoon returned an API-level error. The HTTP status is not specified in the documentation."
                    }
                  },
                  "summary": "Create a bulk verification task",
                  "tags": [
                    "Bulk verification"
                  ]
                }
              },
              "/get-result-bulk-verification-task/": {
                "get": {
                  "description": "Returns task progress while verification is running and email results when they are ready. Reoon's formal request URL uses `task_id`; one Python example in its documentation uses `task-id` instead.",
                  "operationId": "getBulkVerificationTaskResult",
                  "parameters": [
                    {
                      "description": "Task ID returned by the bulk task creation operation.",
                      "in": "query",
                      "name": "task_id",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "examples": {
                            "apiError": {
                              "summary": "API-level error",
                              "value": {
                                "reason": "Task not found",
                                "status": "error"
                              }
                            },
                            "completed": {
                              "summary": "Completed task with results keyed by email",
                              "value": {
                                "count_checked": 2,
                                "count_total": 2,
                                "name": "Spring leads",
                                "progress_percentage": 100,
                                "results": {
                                  "jhon200@outlook.com": {
                                    "can_connect_smtp": true,
                                    "domain": "outlook.com",
                                    "email": "jhon200@outlook.com",
                                    "has_inbox_full": false,
                                    "is_catch_all": false,
                                    "is_deliverable": true,
                                    "is_disabled": false,
                                    "is_disposable": false,
                                    "is_role_account": false,
                                    "is_safe_to_send": true,
                                    "is_spamtrap": false,
                                    "is_valid_syntax": true,
                                    "mx_accepts_mail": true,
                                    "mx_records": [
                                      "outlook-com.olc.protection.outlook.com"
                                    ],
                                    "status": "safe",
                                    "username": "jhon200"
                                  }
                                },
                                "status": "completed",
                                "task_id": "40676"
                              }
                            },
                            "running": {
                              "summary": "Task still processing",
                              "value": {
                                "count_checked": 1,
                                "count_total": 2,
                                "name": "Spring leads",
                                "progress_percentage": 50,
                                "status": "running",
                                "task_id": "40676"
                              }
                            }
                          },
                          "schema": {
                            "oneOf": [
                              {
                                "$ref": "#/components/schemas/BulkTaskResult"
                              },
                              {
                                "$ref": "#/components/schemas/ApiError"
                              }
                            ]
                          }
                        }
                      },
                      "description": "Task progress, completed results, or an API-level error."
                    }
                  },
                  "security": [
                    {
                      "ReoonApiKey": []
                    }
                  ],
                  "summary": "Get bulk task progress or results",
                  "tags": [
                    "Bulk verification"
                  ]
                }
              },
              "/verify": {
                "get": {
                  "description": "Quick mode is the default and checks syntax, disposable status, MX and related signals without checking whether the individual inbox exists. Power mode performs deeper checks and can take from seconds to over a minute. Reoon advises against continuously using this endpoint with more than five concurrent threads; use the bulk API for larger lists.",
                  "operationId": "verifyEmail",
                  "parameters": [
                    {
                      "description": "Email address to verify.",
                      "in": "query",
                      "name": "email",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Verification depth. Omit to use quick mode.",
                      "in": "query",
                      "name": "mode",
                      "schema": {
                        "default": "quick",
                        "enum": [
                          "quick",
                          "power"
                        ],
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "examples": {
                            "power": {
                              "summary": "Power mode result",
                              "value": {
                                "can_connect_smtp": true,
                                "domain": "gmail.com",
                                "email": "jhon123@gmail.com",
                                "has_inbox_full": false,
                                "is_catch_all": false,
                                "is_deliverable": true,
                                "is_disabled": false,
                                "is_disposable": false,
                                "is_free_email": true,
                                "is_role_account": false,
                                "is_safe_to_send": true,
                                "is_spamtrap": false,
                                "is_valid_syntax": true,
                                "mx_accepts_mail": true,
                                "mx_records": [
                                  "gmail-smtp-in.l.google.com",
                                  "alt1.gmail-smtp-in.l.google.com",
                                  "alt2.gmail-smtp-in.l.google.com",
                                  "alt3.gmail-smtp-in.l.google.com",
                                  "alt4.gmail-smtp-in.l.google.com"
                                ],
                                "overall_score": 98,
                                "status": "safe",
                                "username": "jhon123",
                                "verification_mode": "power"
                              }
                            },
                            "quick": {
                              "summary": "Quick mode result",
                              "value": {
