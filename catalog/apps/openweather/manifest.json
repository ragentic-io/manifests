  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "openweather"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.openweathermap.org/data/4.0/onecall",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "Language": {
                  "description": "Language used for weather descriptions.",
                  "in": "query",
                  "name": "lang",
                  "required": false,
                  "schema": {
                    "type": "string"
                  }
                },
                "Latitude": {
                  "description": "Latitude in decimal degrees, from -90 to 90.",
                  "in": "query",
                  "name": "lat",
                  "required": true,
                  "schema": {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  }
                },
                "Longitude": {
                  "description": "Longitude in decimal degrees, from -180 to 180.",
                  "in": "query",
                  "name": "lon",
                  "required": true,
                  "schema": {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  }
                },
                "TimelineStart": {
                  "description": "UTC Unix timestamp used as the starting point for timeline data; defaults to the current UTC time.",
                  "in": "query",
                  "name": "start",
                  "required": false,
                  "schema": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "Units": {
                  "description": "Units for temperature and wind speed. Defaults to standard units.",
                  "in": "query",
                  "name": "units",
                  "required": false,
                  "schema": {
                    "enum": [
                      "standard",
                      "metric",
                      "imperial"
                    ],
                    "type": "string"
                  }
                }
              },
              "schemas": {
                "CurrentObservation": {
                  "properties": {
                    "alerts": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "clouds": {
                      "type": "integer"
                    },
                    "dew_point": {
                      "type": "number"
                    },
                    "dt": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "feels_like": {
                      "type": "number"
                    },
                    "humidity": {
                      "type": "integer"
                    },
                    "pressure": {
                      "type": "integer"
                    },
                    "rain": {
                      "$ref": "#/components/schemas/PrecipitationAmount"
                    },
                    "snow": {
                      "$ref": "#/components/schemas/PrecipitationAmount"
                    },
                    "sunrise": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "sunset": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "temp": {
                      "type": "number"
                    },
                    "uvi": {
                      "type": "number"
                    },
                    "visibility": {
                      "type": "integer"
                    },
                    "weather": {
                      "items": {
                        "$ref": "#/components/schemas/WeatherCondition"
                      },
                      "type": "array"
                    },
                    "wind_deg": {
                      "type": "integer"
                    },
                    "wind_gust": {
                      "type": "number"
                    },
                    "wind_speed": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "CurrentWeatherResponse": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/WeatherEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/CurrentObservation"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "DailyRecord": {
                  "properties": {
                    "alerts": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "clouds": {
                      "type": "integer"
                    },
                    "dew_point": {
                      "type": "number"
                    },
                    "dt": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "feels_like": {
                      "properties": {
                        "day": {
                          "type": "number"
                        },
                        "eve": {
                          "type": "number"
                        },
                        "morn": {
                          "type": "number"
                        },
                        "night": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "humidity": {
                      "type": "integer"
                    },
                    "moon_phase": {
                      "type": "number"
                    },
                    "moonrise": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "moonset": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "pop": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "pressure": {
                      "type": "integer"
                    },
                    "rain": {
                      "type": "number"
                    },
                    "snow": {
                      "type": "number"
                    },
                    "sunrise": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "sunset": {
                      "format": "int64",
                      "type": "integer"
                    },
                    "temp": {
                      "properties": {
                        "day": {
                          "type": "number"
                        },
                        "eve": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "min": {
                          "type": "number"
                        },
                        "morn": {
                          "type": "number"
                        },
                        "night": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    "uvi": {
                      "type": "number"
                    },
                    "visibility": {
                      "type": "integer"
                    },
                    "weather": {
                      "items": {
                        "$ref": "#/components/schemas/WeatherCondition"
                      },
                      "type": "array"
                    },
                    "wind_deg": {
                      "type": "integer"
