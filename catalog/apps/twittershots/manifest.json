                          "schema": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "401": {
                      "description": "Missing or invalid X-API-KEY"
                    },
                    "403": {
                      "description": "Quota exceeded or plan restriction"
                    },
                    "404": {
                      "description": "Tweet not found or unavailable"
                    }
                  },
                  "summary": "Generate a tweet screenshot"
                }
              },
