                "get": {
                  "description": "Returns a rendered screenshot of a public tweet as PNG, SVG, or HTML.\nQuota remaining is returned in X-Quota-Remaining and X-Quota-Limit response headers.\n",
                  "operationId": "getTweetScreenshot",
                  "parameters": [
                    {
                      "description": "Tweet status ID (numeric) or full tweet URL",
                      "example": "1981415642981888505",
                      "in": "path",
                      "name": "tweetId",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Output format",
                      "in": "query",
                      "name": "format",
                      "required": false,
                      "schema": {
                        "default": "svg",
                        "enum": [
                          "svg",
                          "png",
                          "html"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Color theme",
                      "in": "query",
                      "name": "theme",
                      "required": false,
                      "schema": {
                        "default": "light",
                        "enum": [
                          "light",
                          "dark"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "buffer returns image bytes; url returns JSON with a hosted image URL",
                      "in": "query",
                      "name": "returnType",
                      "required": false,
                      "schema": {
                        "default": "buffer",
                        "enum": [
                          "buffer",
                          "url"
                        ],
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "properties": {
                              "format": {
                                "type": "string"
                              },
                              "tweetId": {
                                "type": "string"
                              },
                              "url": {
                                "format": "uri",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          }
                        },
                        "image/png": {
                          "schema": {
                            "format": "binary",
                            "type": "string"
                          }
                        },
                        "image/svg+xml": {
                          "schema": {
                            "format": "binary",
                            "type": "string"
                          }
                        },
                        "text/html": {
                          "schema": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "Screenshot image (buffer) or JSON with url when returnType=url",
                      "headers": {
                        "X-Quota-Limit": {
                          "description": "Total API credits for the current period",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-Quota-Remaining": {
