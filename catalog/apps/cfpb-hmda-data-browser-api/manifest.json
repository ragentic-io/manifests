                      "2"
                    ],
                    "type": "string"
                  }
                },
                "loan_products": {
                  "description": "Documented loan product categories.",
                  "in": "query",
                  "name": "loan_products",
                  "required": false,
                  "schema": {
                    "enum": [
                      "Conventional:First Lien",
                      "FHA:First Lien",
                      "VA:First Lien",
                      "FSA/RHS:First Lien",
                      "Conventional:Subordinate Lien",
                      "FHA:Subordinate Lien",
                      "VA:Subordinate Lien",
                      "FSA/RHS:Subordinate Lien"
                    ],
                    "type": "string"
                  }
                },
                "loan_purposes": {
                  "description": "Documented loan purpose codes.",
                  "in": "query",
                  "name": "loan_purposes",
                  "required": false,
                  "schema": {
                    "enum": [
                      "1",
                      "2",
                      "31",
                      "32",
                      "4",
                      "5"
                    ],
                    "type": "string"
                  }
                },
                "loan_types": {
                  "description": "Documented loan type codes.",
                  "in": "query",
                  "name": "loan_types",
                  "required": false,
                  "schema": {
                    "enum": [
                      "1",
                      "2",
                      "3",
                      "4"
                    ],
                    "type": "string"
                  }
                },
                "msamds": {
                  "description": "Five-digit MSA/MD code; multiple codes can be comma-separated.",
                  "in": "query",
                  "name": "msamds",
                  "required": false,
                  "schema": {
                    "type": "string"
                  }
                },
                "races": {
                  "description": "Documented race categories.",
                  "in": "query",
                  "name": "races",
                  "required": false,
                  "schema": {
                    "enum": [
                      "Asian",
                      "Native Hawaiian or Other Pacific Islander",
                      "Free Form Text Only",
                      "Race Not Available",
                      "American Indian or Alaska Native",
                      "Black or African American",
                      "2 or more minority races",
                      "White",
                      "Joint"
                    ],
                    "type": "string"
                  }
                },
                "sexes": {
                  "description": "Documented sex categories.",
                  "in": "query",
                  "name": "sexes",
                  "required": false,
                  "schema": {
                    "enum": [
                      "Male",
                      "Female",
                      "Joint",
                      "Sex Not Available"
                    ],
                    "type": "string"
                  }
                },
                "states": {
                  "description": "Two-letter state abbreviation; multiple codes can be comma-separated.",
                  "in": "query",
                  "name": "states",
                  "required": false,
                  "schema": {
                    "example": "CA,MD,DC",
                    "type": "string"
                  }
                },
                "total_units": {
                  "description": "Documented total unit counts or ranges.",
                  "in": "query",
                  "name": "total_units",
                  "required": false,
                  "schema": {
                    "enum": [
                      "1",
                      "2",
                      "3",
                      "4",
                      "5-24",
                      "25-49",
                      "50-99",
                      "100-149",
                      ">149"
                    ],
                    "type": "string"
                  }
                },
                "years": {
                  "description": "Filing year or comma-separated filing years.",
                  "in": "query",
                  "name": "years",
                  "required": true,
                  "schema": {
                    "example": "2018,2019",
                    "type": "string"
                  }
                }
