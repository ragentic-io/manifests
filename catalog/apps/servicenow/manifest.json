                  "name": "sysparm_offset",
                  "schema": {
                    "default": 0,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "SysparmQuery": {
                  "description": "Encoded query used to filter the result set.",
                  "in": "query",
                  "name": "sysparm_query",
                  "schema": {
                    "type": "string"
                  }
