                      "in": "query",
                      "name": "maxKeys",
                      "required": false,
                      "schema": {
                        "default": 10,
                        "maximum": 1000,
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Sort the files in ascending or descending order",
                      "in": "query",
