  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "openstreetmap"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.openstreetmap.org/api/0.6",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "changesetId": {
                  "description": "Numeric OpenStreetMap changeset ID.",
                  "in": "path",
                  "name": "id",
                  "required": true,
                  "schema": {
                    "format": "int64",
                    "type": "integer"
                  }
                },
                "elementId": {
                  "description": "Numeric OpenStreetMap element ID.",
                  "in": "path",
                  "name": "id",
                  "required": true,
                  "schema": {
                    "format": "int64",
                    "type": "integer"
                  }
                }
              },
              "schemas": {
                "OsmChangeXml": {
                  "description": "UTF-8 OsmChange XML document.",
                  "format": "xml",
                  "type": "string"
                },
                "OsmJson": {
                  "additionalProperties": true,
                  "properties": {
                    "elements": {
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "changeset": {
                            "type": "integer"
                          },
                          "id": {
                            "format": "int64",
                            "type": "integer"
                          },
                          "lat": {
                            "type": "number"
                          },
                          "lon": {
                            "type": "number"
                          },
                          "timestamp": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "node",
                              "way",
                              "relation"
                            ],
                            "type": "string"
                          },
                          "version": {
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "generator": {
                      "type": "string"
                    },
                    "version": {
                      "const": "0.6",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "OsmXml": {
                  "description": "UTF-8 OpenStreetMap XML document.",
                  "format": "xml",
                  "type": "string"
                }
              },
              "securitySchemes": {
                "osmOAuth": {
                  "flows": {
                    "authorizationCode": {
                      "authorizationUrl": "https://www.openstreetmap.org/oauth2/authorize",
                      "scopes": {
                        "write_api": "Modify OpenStreetMap map data."
                      },
                      "tokenUrl": "https://www.openstreetmap.org/oauth2/token"
                    }
                  },
                  "type": "oauth2"
                }
              }
            },
            "externalDocs": {
              "description": "OpenStreetMap API v0.6 documentation",
              "url": "https://wiki.openstreetmap.org/wiki/API_v0.6"
            },
            "info": {
              "description": "Community-maintained subset of the OpenStreetMap Editing API. The API is intended for editing map data, not for read-only projects or bulk data access; follow the OpenStreetMap API Usage Policy. The source wiki itself notes that it is not official documentation and that behavior may change.",
              "title": "OpenStreetMap Editing API",
              "version": "0.6"
            },
            "openapi": "3.1.0",
            "paths": {
              "/capabilities": {
                "get": {
                  "operationId": "getCapabilities",
                  "responses": {
