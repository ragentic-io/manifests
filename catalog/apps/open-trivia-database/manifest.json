    "spec": {
      "base": {
        "endpoint": "https://opentdb.com",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "JsonResponse": {
                  "additionalProperties": true,
                  "description": "The provider documents response behavior but not the JSON property schema.",
                  "type": "object"
                }
              }
            },
            "externalDocs": {
              "description": "Official Open Trivia Database API documentation",
              "url": "https://opentdb.com/api_config.php"
            },
            "info": {
              "description": "Community-maintained description of the public Open Trivia Database API.\nThe provider says the JSON API is free and requires no API key. It limits\neach IP address to one request every five seconds and allows at most 50\nquestions per request. The provider documents response-code meanings but\ndoes not publish response property schemas, so response objects are left\nopen rather than guessing fields. Question data is licensed CC BY-SA 4.0.",
              "title": "Open Trivia Database API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/api.php": {
                "get": {
                  "description": "Only one category can be requested per call. Omit category to retrieve\nquestions from any category. The provider documents response codes for\nsuccess, insufficient results, invalid parameters, missing or exhausted\ntokens, and rate limiting.",
                  "operationId": "getQuestions",
                  "parameters": [
                    {
                      "description": "Number of questions to retrieve; maximum 50.",
                      "example": 10,
                      "in": "query",
                      "name": "amount",
                      "required": true,
                      "schema": {
                        "maximum": 50,
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Category ID. Only one category may be selected per call.",
                      "in": "query",
                      "name": "category",
                      "schema": {
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Question difficulty.",
                      "in": "query",
                      "name": "difficulty",
                      "schema": {
                        "enum": [
                          "easy",
                          "medium",
                          "hard"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Question type.",
                      "in": "query",
                      "name": "type",
                      "schema": {
                        "enum": [
                          "multiple",
                          "boolean"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Response encoding. If omitted, the API uses its default HTML-code encoding.",
                      "in": "query",
                      "name": "encode",
                      "schema": {
                        "enum": [
                          "urlLegacy",
                          "url3986",
                          "base64"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Session token used to avoid returning previously retrieved questions. Tokens expire after six hours of inactivity.",
                      "in": "query",
                      "name": "token",
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/JsonResponse"
                          }
                        }
                      },
                      "description": "JSON result or documented response-code outcome."
                    }
                  },
                  "summary": "Retrieve trivia questions",
                  "tags": [
                    "Questions"
                  ]
                }
              },
              "/api_category.php": {
                "get": {
                  "operationId": "listCategories",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/JsonResponse"
                          }
                        }
                      },
                      "description": "JSON category list with category names and IDs."
                    }
                  },
                  "summary": "List trivia categories",
                  "tags": [
                    "Categories"
                  ]
                }
              },
              "/api_count.php": {
                "get": {
                  "operationId": "getCategoryQuestionCount",
                  "parameters": [
                    {
                      "description": "Category ID.",
                      "in": "query",
                      "name": "category",
                      "required": true,
                      "schema": {
                        "type": "integer"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/JsonResponse"
                          }
                        }
                      },
                      "description": "JSON question count for the category."
                    }
                  },
                  "summary": "Get a category's question count",
                  "tags": [
                    "Counts"
                  ]
                }
              },
              "/api_count_global.php": {
                "get": {
                  "operationId": "getGlobalQuestionCounts",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/JsonResponse"
                          }
                        }
                      },
                      "description": "JSON counts for total, pending, verified, and rejected questions."
                    }
                  },
                  "summary": "Get global question counts",
                  "tags": [
                    "Counts"
                  ]
                }
              },
              "/api_token.php": {
                "get": {
                  "description": "Resetting a token clears its question history. A token is deleted after six hours of inactivity.",
                  "operationId": "manageSessionToken",
                  "parameters": [
                    {
                      "description": "Request a new token or reset an existing token.",
                      "in": "query",
                      "name": "command",
                      "required": true,
                      "schema": {
                        "enum": [
                          "request",
                          "reset"
                        ],
                        "type": "string"
                      }
                    },
                    {
                      "description": "Required when command is reset.",
                      "in": "query",
                      "name": "token",
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/JsonResponse"
                          }
                        }
                      },
                      "description": "JSON token operation result."
                    }
                  },
                  "summary": "Request or reset a session token",
                  "tags": [
                    "Session tokens"
                  ]
                }
              }
