                      "type": "object"
                    },
                    "lon": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "Measurements": {
                  "description": "Temperature units follow the units query parameter.",
                  "properties": {
                    "feels_like": {
                      "type": "number"
                    },
                    "grnd_level": {
                      "description": "Ground-level atmospheric pressure in hPa.",
                      "type": "number"
                    },
                    "humidity": {
                      "description": "Humidity percentage.",
                      "type": "number"
                    },
                    "pressure": {
                      "description": "Atmospheric pressure in hPa.",
                      "type": "number"
                    },
                    "sea_level": {
                      "description": "Sea-level atmospheric pressure in hPa.",
                      "type": "number"
                    },
                    "temp": {
                      "type": "number"
                    },
                    "temp_max": {
                      "type": "number"
                    },
                    "temp_min": {
                      "type": "number"
                    }
