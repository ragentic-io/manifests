                        }
                      },
                      "type": "object"
                    },
                    "visibility": {
                      "type": "integer"
                    },
                    "weather": {
                      "items": {
                        "$ref": "#/components/schemas/WeatherCondition"
                      },
                      "type": "array"
                    },
                    "wind": {
                      "$ref": "#/components/schemas/Wind"
                    }
                  },
                  "type": "object"
