                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "sunrise": {
                          "type": "integer"
                        },
                        "sunset": {
                          "type": "integer"
                        },
                        "type": {
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "timezone": {
                      "description": "Shift in seconds from UTC.",
                      "type": "integer"
                    },
                    "visibility": {
                      "type": "integer"
                    },
                    "weather": {
                      "items": {
                        "$ref": "#/components/schemas/WeatherCondition"
                      },
                      "type": "array"
                    },
                    "wind": {
                      "$ref": "#/components/schemas/Wind"
                    }
                  },
                  "type": "object"
                },
                "Forecast": {
                  "properties": {
                    "city": {
                      "properties": {
                        "coord": {
                          "$ref": "#/components/schemas/Coordinates"
                        },
                        "country": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "population": {
                          "type": "integer"
                        },
                        "sunrise": {
                          "type": "integer"
                        },
                        "sunset": {
                          "type": "integer"
                        },
                        "timezone": {
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "cnt": {
                      "type": "integer"
                    },
                    "cod": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "list": {
                      "items": {
                        "$ref": "#/components/schemas/ForecastPeriod"
                      },
                      "type": "array"
                    },
                    "message": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "ForecastPeriod": {
                  "properties": {
                    "clouds": {
                      "$ref": "#/components/schemas/Clouds"
                    },
                    "dt": {
                      "description": "Forecast time in Unix UTC seconds.",
                      "type": "integer"
                    },
                    "dt_txt": {
                      "description": "Forecast time in UTC ISO format.",
                      "type": "string"
                    },
                    "main": {
                      "$ref": "#/components/schemas/Measurements"
                    },
                    "pop": {
                      "description": "Probability of precipitation from zero to one.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "rain": {
                      "$ref": "#/components/schemas/Precipitation"
                    },
                    "snow": {
                      "$ref": "#/components/schemas/Precipitation"
                    },
                    "sys": {
                      "properties": {
                        "pod": {
