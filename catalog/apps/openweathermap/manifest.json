              },
              "description": "Community-maintained specification for OpenWeather's documented JSON current-weather, five-day forecast, and geocoding endpoints. An API key and free account are required. Deprecated city-name, city-ID, and postal code lookups on the weather endpoints and non-free products are omitted.",
              "title": "OpenWeather Current Weather, Forecast, and Geocoding API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
