                    },
                    "500": {
                      "$ref": "#/components/responses/ServerError"
                    }
                  },
                  "security": [
                    {
                      "OOPSpamApiKey": []
                    }
                  ],
                  "summary": "Check a domain against reputation sources",
                  "tags": [
                    "Domain reputation"
                  ]
                }
              },
