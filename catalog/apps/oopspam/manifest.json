    "spec": {
      "base": {
        "endpoint": "https://api.oopspam.com/v1",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "responses": {
                "BadRequest": {
                  "description": "The request is invalid."
                },
                "NotAcceptable": {
                  "description": "The requested response format is not JSON."
                },
                "NotFound": {
                  "description": "The requested resource was not found."
                },
                "RateLimited": {
                  "description": "The API key exceeded its request limit."
                },
                "ServerError": {
                  "description": "An internal server error occurred."
                },
                "Unauthorized": {
                  "description": "The API key is invalid."
                }
              },
              "schemas": {
                "DomainReputationRequest": {
                  "properties": {
                    "domain": {
                      "description": "Fully qualified domain name without a scheme or `www` prefix.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "domain"
                  ],
                  "type": "object"
                },
                "DomainReputationResult": {
                  "properties": {
                    "Blocked": {
                      "type": "boolean"
                    },
                    "Blocker": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "Blocked",
                    "Blocker"
                  ],
                  "type": "object"
                },
                "SpamDetectionDetails": {
                  "additionalProperties": true,
                  "description": "Available analyses; fields may be omitted when an analysis returns early.",
                  "properties": {
                    "countryMatch": {
                      "type": "boolean"
                    },
                    "isContentSpam": {
                      "type": "string"
                    },
                    "isContentTooShort": {
                      "type": "boolean"
                    },
                    "isEmailBlocked": {
                      "type": "boolean"
                    },
                    "isIPBlocked": {
                      "type": "boolean"
                    },
                    "langMatch": {
                      "type": "boolean"
                    },
                    "numberOfSpamWords": {
                      "type": "number"
                    },
                    "spamWords": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "SpamDetectionReportRequest": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SpamDetectionRequest"
                    },
                    {
                      "properties": {
                        "shouldBeSpam": {
                          "description": "Whether the reported content should be classified as spam.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "shouldBeSpam"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "SpamDetectionRequest": {
                  "properties": {
                    "allowedCountries": {
                      "description": "Allowed ISO 3166-1 alpha-2 country codes; requires `senderIP`.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "allowedLanguages": {
                      "description": "Expected ISO 639-1 language codes.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "blockDC": {
                      "default": false,
                      "description": "Block IP addresses from data centers.",
                      "type": "boolean"
                    },
                    "blockTempEmail": {
                      "default": false,
                      "description": "Block temporary or disposable email addresses.",
                      "type": "boolean"
                    },
                    "blockVPN": {
                      "default": false,
                      "description": "Block VPN, proxy, and Tor IP addresses.",
                      "type": "boolean"
                    },
                    "blockedCountries": {
                      "description": "Blocked ISO 3166-1 alpha-2 country codes; requires `senderIP`.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "checkForLength": {
                      "default": true,
                      "description": "Treat content shorter than 20 characters as spam.",
                      "type": "boolean"
                    },
                    "content": {
                      "description": "Message or content to analyze.",
                      "type": "string"
                    },
                    "context": {
                      "description": "Describe the site's purpose and what submissions count as spam or legitimate. When a non-empty value is supplied, contextual detection is used instead of standard spam detection.",
                      "type": "string"
                    },
                    "email": {
                      "description": "Original submitter's email address.",
                      "type": "string"
                    },
                    "logIt": {
                      "default": false,
                      "description": "Enable dashboard logging; requires `source`.",
                      "type": "boolean"
                    },
                    "senderIP": {
                      "description": "Original submitter's IP address; required for country filters.",
                      "type": "string"
                    },
                    "source": {
                      "description": "Unique site or application identifier used for dashboard logging.",
                      "type": "string"
                    },
                    "urlFriendly": {
                      "default": false,
                      "description": "Beta option to reduce the impact of links in `content` on its spam score.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "SpamDetectionResult": {
                  "properties": {
                    "Details": {
                      "$ref": "#/components/schemas/SpamDetectionDetails"
                    },
                    "Score": {
                      "description": "Overall spam score; higher values indicate a greater likelihood of spam.",
                      "maximum": 6,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "Score",
                    "Details"
                  ],
                  "type": "object"
                }
              },
              "securitySchemes": {
                "OOPSpamApiKey": {
                  "in": "header",
                  "name": "X-Api-Key",
                  "type": "apiKey"
                }
              }
            },
            "externalDocs": {
              "description": "OOPSpam API documentation",
              "url": "https://www.oopspam.com/docs/"
            },
            "info": {
              "description": "Community-maintained description of OOPSpam's direct API. This document does not describe the separate RapidAPI base URL and authentication header.",
              "title": "OOPSpam API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
