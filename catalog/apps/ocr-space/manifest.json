    "spec": {
      "base": {
        "endpoint": "https://api.ocr.space",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "OcrRequestFields": {
                  "description": "Send exactly one input source: `url`, `file`, or `base64Image`.",
                  "properties": {
                    "OCREngine": {
                      "default": 2,
                      "description": "OCR engine selection.",
                      "enum": [
                        1,
                        2,
                        3
                      ],
                      "type": "integer"
                    },
                    "base64Image": {
                      "description": "Base64-encoded image or PDF.",
                      "type": "string"
                    },
                    "detectOrientation": {
                      "description": "Automatically rotate the image and return its text orientation.",
                      "type": "boolean"
                    },
                    "file": {
                      "description": "Multipart image or PDF file.",
                      "format": "binary",
                      "type": "string"
                    },
                    "filetype": {
                      "description": "Override file type detection.",
                      "enum": [
                        "PDF",
                        "GIF",
                        "PNG",
                        "JPG",
                        "TIF",
                        "BMP"
                      ],
                      "type": "string"
                    },
                    "isCreateSearchablePdf": {
                      "default": false,
                      "description": "Create a searchable PDF and enable overlay data.",
                      "type": "boolean"
                    },
                    "isOverlayRequired": {
                      "default": false,
                      "description": "Return word-level position data.",
                      "type": "boolean"
                    },
                    "isSearchablePdfHideTextLayer": {
                      "default": false,
                      "description": "Hide the text layer in a generated searchable PDF.",
                      "type": "boolean"
                    },
                    "isTable": {
                      "description": "Format parsed text line by line for table-like documents.",
                      "type": "boolean"
                    },
                    "language": {
                      "description": "Three-letter OCR language code; `auto` is supported by engines 2 and 3.",
                      "type": "string"
                    },
                    "scale": {
                      "default": false,
                      "description": "Apply internal image upscaling.",
                      "type": "boolean"
                    },
                    "url": {
                      "description": "Remote image or PDF URL.",
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "OcrResponse": {
                  "properties": {
                    "ErrorDetails": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ErrorMessage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "IsErroredOnProcessing": {
                      "type": "boolean"
                    },
                    "OCRExitCode": {
                      "description": "Overall OCR status code.",
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "ParsedResults": {
                      "items": {
                        "$ref": "#/components/schemas/ParsedResult"
                      },
                      "type": "array"
                    },
                    "ProcessingTimeInMilliseconds": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "SearchablePDFURL": {
                      "format": "uri",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "type": "object"
                },
                "OverlayLine": {
                  "properties": {
                    "MaxHeight": {
                      "type": "number"
                    },
                    "MinTop": {
                      "type": "number"
                    },
                    "Words": {
                      "items": {
                        "$ref": "#/components/schemas/OverlayWord"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "OverlayWord": {
                  "properties": {
                    "Height": {
                      "type": "number"
                    },
                    "Left": {
                      "type": "number"
                    },
                    "Top": {
                      "type": "number"
                    },
                    "Width": {
                      "type": "number"
                    },
                    "WordText": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "ParsedResult": {
                  "properties": {
                    "ErrorDetails": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ErrorMessage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "FileParseExitCode": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "ParsedText": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "TextOrientation": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "TextOverlay": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/TextOverlay"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "type": "object"
