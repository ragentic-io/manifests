                        "$ref": "#/components/schemas/OverlayLine"
                      },
                      "type": "array"
                    },
                    "Message": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "type": "object"
                }
              },
              "securitySchemes": {
                "apiKeyHeader": {
                  "in": "header",
                  "name": "apikey",
                  "type": "apiKey"
                },
                "apiKeyQuery": {
                  "in": "query",
                  "name": "apikey",
                  "type": "apiKey"
                }
              }
            },
            "info": {
              "description": "Submit an image or PDF URL, a multipart file, or a Base64 image/PDF to the free OCR API. A free API key is available by registration; the documented free tier allows 500 requests per day per IP and 25,000 requests per month.",
              "externalDocs": {
                "description": "OCR.space API documentation",
                "url": "https://ocr.space/ocrapi"
              },
              "title": "OCR.space OCR API",
              "version": "1.0.0"
            },
            "openapi": "3.2.1",
            "paths": {
              "/parse/image": {
                "post": {
                  "description": "Send exactly one of `url`, `file`, or `base64Image`. The provider documents API key authentication in the `apikey` header for this POST endpoint. Searchable PDF creation is available with the documented request options.",
                  "operationId": "parseImage",
                  "requestBody": {
                    "content": {
                      "multipart/form-data": {
                        "schema": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/OcrRequestFields"
                            },
                            {
                              "oneOf": [
                                {
                                  "required": [
                                    "url"
                                  ]
                                },
                                {
                                  "required": [
                                    "file"
                                  ]
                                },
                                {
                                  "required": [
                                    "base64Image"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/OcrResponse"
                          }
                        }
                      },
                      "description": "OCR processing result. Processing errors are reported in the JSON body."
                    }
                  },
                  "security": [
                    {
                      "apiKeyHeader": []
                    }
                  ],
                  "summary": "Parse an image or PDF"
                }
              },
              "/parse/imageurl": {
                "get": {
                  "description": "This GET endpoint accepts a remote image or PDF URL only; it does not accept file uploads or Base64 input. Its API key is sent in the query string as documented by the provider.",
                  "operationId": "parseImageUrl",
                  "parameters": [
                    {
                      "description": "URL of a remote image or PDF with a suitable content type.",
                      "in": "query",
                      "name": "url",
                      "required": true,
                      "schema": {
                        "format": "uri",
                        "type": "string"
                      }
                    },
                    {
                      "description": "Three-letter OCR language code; `auto` is supported by engines 2 and 3.",
                      "in": "query",
                      "name": "language",
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Return word-level position data.",
                      "in": "query",
                      "name": "isOverlayRequired",
                      "schema": {
                        "default": false,
                        "type": "boolean"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/OcrResponse"
                          }
                        }
                      },
                      "description": "OCR processing result. Processing errors are reported in the JSON body."
                    }
                  },
                  "security": [
                    {
                      "apiKeyQuery": []
                    }
                  ],
                  "summary": "Parse an image or PDF from a URL"
                }
              }
            },
            "servers": [
              {
                "description": "Free OCR API",
                "url": "https://api.ocr.space"
              }
            ]
