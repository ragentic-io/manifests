                    {
                      "description": "NASA ID of a media asset.",
                      "in": "query",
                      "name": "nasa_id",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "One-based result page.",
                      "in": "query",
                      "name": "page",
                      "required": false,
                      "schema": {
                        "minimum": 1,
                        "type": "integer"
