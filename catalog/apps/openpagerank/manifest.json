                }
              }
            },
            "info": {
              "contact": {
                "name": "OpenPageRank",
                "url": "https://openpagerank.keywordseverywhere.com"
              },
              "description": "Authority (OpenPageRank, a 0-10 score) for up to 100 domains per call, each with its full monthly history back to 2018.\n\n**One data call:** `POST /v1/domains/bulk`. History is included by default; set `include_history: false` for a lighter, current-only response.\n\n**Domain limits:** each domain looked up (current **and** history) counts once toward your **monthly domain limit**, free 30,000, bronze 100,000, silver 200,000, gold 1,000,000, platinum 4,000,000. Watch the `X-Domains-*` response headers, or call `GET /v1/usage` to see how many you've used. Limits reset on the 1st of each month.\n\n**Auth:** send your OPR API key as `Authorization: Bearer <key>` (mint keys in the dashboard).",
              "title": "OpenPageRank API",
              "version": "1.0.0"
            },
            "openapi": "3.0.3",
            "paths": {
              "/v1/domains/bulk": {
                "post": {
                  "description": "Returns the current OpenPageRank and, by default, the full monthly history for up to 100 domains. Each unique domain counts once toward your monthly domain limit (history included or not). Input accepts a bare domain, hostname, or full URL, it is reduced to the registered domain.\n\nA subdomain input (blog.example.com, but not bare www) additionally attaches a `hosts` entry on its root domain's result with the subdomain's own score on the same 0-10 scale. Subdomain data is free (it does not count toward the monthly limit; up to 100 unique hostnames per request), and a subdomain never scores above its root domain.",
                  "operationId": "lookupDomains",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "example": {
                          "domains": [
                            "github.com",
                            "google.com"
                          ],
                          "include_history": true
                        },
                        "schema": {
                          "properties": {
                            "domains": {
                              "description": "Up to 100 unique domains. Duplicates and equivalent forms (e.g. URLs of the same site) are merged before the limit is applied.",
                              "example": [
                                "github.com",
                                "google.com"
                              ],
                              "items": {
                                "type": "string"
                              },
                              "maxItems": 100,
                              "type": "array"
                            },
                            "include_history": {
                              "default": true,
                              "description": "Include the monthly history array per domain. Set false for a smaller, current-only response.",
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "domains"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/BulkResponse"
                          }
                        }
                      },
                      "description": "Per-domain results, in request order.",
                      "headers": {
                        "X-Domains-Limit": {
                          "description": "Monthly domain allowance for the plan.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-Domains-Remaining": {
                          "description": "Domains left this month.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-Domains-Reset": {
                          "description": "Unix time when the monthly domain limit resets (first of next month).",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-OPR-Metering": {
                          "description": "Present only while the metering store is briefly unavailable: the call was served but not counted, and the remaining-count headers repeat the plan limits.",
                          "schema": {
                            "enum": [
                              "degraded"
                            ],
                            "type": "string"
                          }
                        },
                        "X-RateLimit-Limit": {
                          "description": "Requests/minute allowed for the plan.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-RateLimit-Remaining": {
                          "description": "Requests left in the current minute.",
                          "schema": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "400": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Error"
                          }
                        }
                      },
                      "description": "Malformed request: missing domains array, over the cap, or include_history is not a boolean."
                    },
                    "401": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Error"
                          }
                        }
                      },
                      "description": "Missing or invalid OPR API key."
                    },
                    "405": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Error"
                          }
                        }
                      },
                      "description": "Wrong HTTP method (use POST). The Allow header lists accepted methods.",
                      "headers": {
                        "Allow": {
                          "description": "Accepted methods.",
                          "schema": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "429": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Error"
                          }
                        }
                      },
                      "description": "Monthly domain limit reached, or per-minute rate exceeded. A rejected call does NOT count against your limit.",
                      "headers": {
                        "X-Domains-Limit": {
                          "description": "Monthly domain allowance for the plan.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-Domains-Remaining": {
                          "description": "Domains left this month.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-Domains-Reset": {
                          "description": "Unix time when the monthly domain limit resets (first of next month).",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-OPR-Metering": {
                          "description": "Present only while the metering store is briefly unavailable: the call was served but not counted, and the remaining-count headers repeat the plan limits.",
                          "schema": {
                            "enum": [
                              "degraded"
                            ],
                            "type": "string"
                          }
                        },
                        "X-RateLimit-Limit": {
                          "description": "Requests/minute allowed for the plan.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "X-RateLimit-Remaining": {
                          "description": "Requests left in the current minute.",
                          "schema": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  },
                  "summary": "Look up domains (current score + monthly history)",
                  "tags": [
                    "domains"
                  ]
                }
