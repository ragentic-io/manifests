        "specification": {
          "document": {
            "components": {
              "schemas": {
                "BulkResponse": {
                  "properties": {
                    "as_of": {
                      "description": "Latest data release.",
                      "example": "2026-06-01",
                      "format": "date",
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "invalid": {
                      "description": "Inputs that could not be parsed to a domain.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "results": {
                      "items": {
                        "$ref": "#/components/schemas/DomainResult"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "DomainResult": {
                  "properties": {
                    "domain": {
                      "example": "github.com",
                      "type": "string"
                    },
                    "found": {
                      "type": "boolean"
                    },
                    "history": {
                      "description": "Monthly series, oldest first. Present only when include_history is not false; omitted from the object entirely otherwise.",
                      "items": {
                        "$ref": "#/components/schemas/HistoryPoint"
                      },
                      "type": "array"
                    },
                    "hosts": {
                      "description": "Present only when the request contained subdomain inputs for this domain: one entry per queried subdomain.",
                      "items": {
                        "$ref": "#/components/schemas/HostResult"
                      },
                      "type": "array"
                    },
                    "open_page_rank": {
                      "description": "Authority score: a number from 0 to 10 with up to 2 decimal places (e.g. 10, 9.7, 4.92). null when not found.",
                      "example": 9.67,
                      "maximum": 10,
                      "minimum": 0,
                      "nullable": true,
                      "type": "number"
                    },
                    "rank": {
                      "description": "Global PageRank position (1 = highest).",
                      "example": 30,
                      "nullable": true,
                      "type": "integer"
                    },
                    "referring_domains": {
                      "description": "Authority-weighted count of linking domains.",
                      "example": 282833,
                      "nullable": true,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "Error": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "param": {
                          "nullable": true,
                          "type": "string"
                        },
                        "type": {
                          "example": "quota_error",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "Health": {
                  "properties": {
                    "as_of": {
                      "example": "2026-06-01",
                      "format": "date",
                      "type": "string"
                    },
                    "status": {
                      "example": "ok",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "HistoryPoint": {
                  "properties": {
                    "date": {
                      "example": "2026-06-01",
                      "format": "date",
                      "type": "string"
                    },
                    "estimated": {
                      "description": "false for a month with a Common Crawl release (measured); true for a month with no release, linearly interpolated from the surrounding measured months. Interpolated months are most common before 2024, when releases were quarterly.",
                      "type": "boolean"
                    },
                    "open_page_rank": {
                      "example": 9.67,
                      "maximum": 10,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "HostResult": {
                  "properties": {
                    "found": {
                      "type": "boolean"
                    },
                    "history": {
                      "description": "Monthly series, oldest first, when include_history is not false. Subdomains scoring below 0.5 keep only their current score (empty history).",
                      "items": {
                        "$ref": "#/components/schemas/HistoryPoint"
                      },
                      "type": "array"
                    },
                    "host": {
                      "example": "pages.github.com",
                      "type": "string"
                    },
                    "open_page_rank": {
                      "description": "Authority score on the same 0-10 scale as domains, so subdomains are comparable with each other and with root domains. Never above the root domain's score. null when not found.",
                      "example": 9.15,
                      "maximum": 10,
                      "minimum": 0,
                      "nullable": true,
                      "type": "number"
                    },
                    "rank": {
                      "description": "Position in the host-level web graph (1 = highest).",
                      "example": 1954,
                      "nullable": true,
                      "type": "integer"
                    },
                    "referring_hosts": {
                      "description": "Authority-filtered count of linking hosts.",
                      "example": 5888,
                      "nullable": true,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "Usage": {
                  "properties": {
                    "domains_remaining": {
                      "type": "integer"
                    },
                    "domains_used": {
                      "description": "Domains looked up so far this month.",
                      "type": "integer"
                    },
                    "monthly_domain_limit": {
                      "description": "Domains you can look up per month on your plan.",
                      "type": "integer"
                    },
                    "requests_per_minute": {
                      "type": "integer"
                    },
                    "resets_at": {
                      "description": "When the monthly domain limit resets.",
                      "format": "date-time",
                      "type": "string"
                    },
                    "tier": {
                      "enum": [
                        "free",
                        "bronze",
                        "silver",
                        "gold",
                        "platinum"
                      ],
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "securitySchemes": {
                "bearerAuth": {
