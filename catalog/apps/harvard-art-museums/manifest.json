  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "harvard-art-museums"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.harvardartmuseums.org",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "Page": {
                  "description": "Page number, starting at 1.",
                  "in": "query",
                  "name": "page",
                  "schema": {
                    "default": 1,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "ResourceId": {
                  "description": "Resource identifier used in the documented path.",
                  "in": "path",
                  "name": "id",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                },
                "Size": {
                  "description": "Number of records per page; defaults to 10 and accepts up to 100.",
                  "in": "query",
                  "name": "size",
                  "schema": {
                    "default": 10,
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  }
                }
              },
              "responses": {
                "Unauthorized": {
                  "description": "The API key is missing, invalid, or malformed."
                }
              },
              "schemas": {
                "CollectionResponse": {
                  "properties": {
                    "aggregations": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "info": {
                      "properties": {
                        "next": {
                          "type": "string"
                        },
                        "page": {
                          "type": "integer"
                        },
                        "pages": {
                          "type": "integer"
                        },
                        "prev": {
                          "type": "string"
                        },
                        "responsetime": {
                          "type": "string"
                        },
                        "totalrecords": {
                          "type": "integer"
                        },
                        "totalrecordsperquery": {
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "records": {
                      "items": {
                        "$ref": "#/components/schemas/ResourceRecord"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "ResourceRecord": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "SubsectionResponse": {
                  "items": {
                    "$ref": "#/components/schemas/ResourceRecord"
                  },
                  "type": "array"
                }
              },
              "securitySchemes": {
                "ApiKey": {
                  "description": "API key requested through the official API documentation.",
                  "in": "query",
                  "name": "apikey",
                  "type": "apiKey"
                }
              }
            },
            "externalDocs": {
              "description": "Official Harvard Art Museums API documentation",
              "url": "https://github.com/harvardartmuseums/api-docs"
            },
            "info": {
              "description": "Focused community-maintained definition for object, person, exhibition, and gallery resources, including documented object subresources. Requests require an API key. The provider limits use to noncommercial applications and 2,500 requests per day.",
              "title": "Harvard Art Museums API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/exhibition": {
                "get": {
                  "operationId": "listExhibitions",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/Size"
                    },
                    {
                      "$ref": "#/components/parameters/Page"
                    },
                    {
                      "description": "Filter exhibitions by venue.",
                      "in": "query",
                      "name": "venue",
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/CollectionResponse"
                          }
                        }
                      },
                      "description": "Paginated exhibition records and available aggregations."
                    },
                    "401": {
                      "$ref": "#/components/responses/Unauthorized"
                    }
                  },
                  "summary": "Search exhibitions",
                  "tags": [
                    "Exhibitions"
                  ]
                }
              },
              "/exhibition/{id}": {
                "get": {
                  "operationId": "getExhibition",
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/ResourceRecord"
                          }
                        }
                      },
                      "description": "An exhibition record."
                    },
                    "401": {
                      "$ref": "#/components/responses/Unauthorized"
                    }
                  },
                  "summary": "Get an exhibition",
                  "tags": [
                    "Exhibitions"
                  ]
                },
                "parameters": [
                  {
                    "$ref": "#/components/parameters/ResourceId"
                  }
                ]
              },
              "/gallery": {
                "get": {
                  "operationId": "listGalleries",
                  "parameters": [
                    {
                      "$ref": "#/components/parameters/Size"
                    },
                    {
                      "$ref": "#/components/parameters/Page"
                    },
                    {
                      "description": "Filter galleries by floor.",
                      "in": "query",
                      "name": "floor",
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/CollectionResponse"
                          }
                        }
                      },
