  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "neocities"
    },
    "spec": {
      "base": {
        "endpoint": "https://neocities.org",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "responses": {
                "BadRequest": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ApiError"
                      }
                    }
                  },
                  "description": "Invalid request."
                },
                "Forbidden": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ApiError"
                      }
                    }
                  },
                  "description": "Invalid credentials."
                },
                "NotFound": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ApiError"
                      }
                    }
                  },
                  "description": "Unknown endpoint or site resource."
                }
              },
              "schemas": {
                "ApiError": {
                  "properties": {
                    "error_type": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "result": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "result",
                    "error_type",
                    "message"
                  ],
                  "type": "object"
                },
                "DirectoryEntry": {
                  "properties": {
                    "created_at": {
                      "description": "Creation date in RFC 2822 format.",
                      "type": "string"
                    },
                    "is_directory": {
                      "const": true
                    },
                    "path": {
                      "type": "string"
                    },
                    "updated_at": {
                      "description": "Modification date in RFC 2822 format.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "is_directory",
                    "created_at",
                    "updated_at"
                  ],
                  "type": "object"
                },
                "FileEntry": {
                  "properties": {
                    "created_at": {
                      "description": "Creation date in RFC 2822 format.",
                      "type": "string"
                    },
                    "is_directory": {
                      "const": false
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha1_hash": {
                      "description": "SHA-1 hash of the file.",
                      "type": "string"
                    },
                    "size": {
                      "description": "File size in bytes.",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "updated_at": {
                      "description": "Modification date in RFC 2822 format.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "is_directory",
                    "created_at",
                    "updated_at",
                    "size",
                    "sha1_hash"
                  ],
                  "type": "object"
                },
                "MessageResponse": {
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "result": {
                      "const": "success"
                    }
                  },
                  "required": [
                    "result",
                    "message"
                  ],
                  "type": "object"
                },
                "SiteInfo": {
                  "properties": {
                    "created_at": {
                      "description": "Creation date in RFC 2822 format.",
                      "type": "string"
                    },
                    "domain": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "hits": {
                      "type": "integer"
                    },
                    "last_updated": {
                      "description": "Last update date in RFC 2822 format.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sitename": {
                      "type": "string"
                    },
                    "supporter": {
                      "type": "boolean"
                    },
                    "tags": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "views": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "sitename",
                    "views",
                    "hits",
                    "created_at",
                    "last_updated",
                    "domain",
                    "supporter",
                    "tags"
                  ],
                  "type": "object"
                }
              },
              "securitySchemes": {
                "bearerAuth": {
                  "description": "API key from the site's settings.",
                  "scheme": "bearer",
                  "type": "http"
                }
              }
            },
            "externalDocs": {
              "description": "Neocities Developer API documentation",
              "url": "https://neocities.org/api"
            },
            "info": {
              "description": "Manage files and retrieve site information on Neocities.",
              "externalDocs": {
                "description": "Neocities API documentation",
                "url": "https://neocities.org/api"
              },
              "title": "Neocities Developer API",
              "version": "2026-10-01"
            },
            "openapi": "3.1.0",
            "paths": {
              "/api/create_directory": {
                "post": {
                  "description": "Missing parent directories are created automatically. The request fails if a file or directory already exists at the destination.",
                  "operationId": "createDirectory",
                  "requestBody": {
                    "content": {
                      "application/x-www-form-urlencoded": {
                        "schema": {
                          "properties": {
                            "path": {
                              "description": "Site-relative directory path.",
                              "example": "images/cats",
                              "type": "string"
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/MessageResponse"
                          }
                        }
                      },
                      "description": "Directory created."
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    }
                  ],
                  "summary": "Create a directory",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/delete": {
                "post": {
                  "description": "Deleting a directory also removes its contents. Deletion cannot be undone. The root directory and root index.html are protected.",
                  "operationId": "deletePaths",
                  "requestBody": {
                    "content": {
                      "application/x-www-form-urlencoded": {
                        "encoding": {
                          "filenames[]": {
                            "explode": true,
                            "style": "form"
                          }
                        },
                        "schema": {
                          "properties": {
                            "filenames[]": {
                              "description": "Repeat this field for each site-relative path to delete.",
                              "items": {
                                "type": "string"
                              },
                              "minItems": 1,
                              "type": "array"
                            }
                          },
                          "required": [
                            "filenames[]"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/MessageResponse"
                          }
                        }
                      },
                      "description": "Paths deleted."
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    }
                  ],
                  "summary": "Delete files or directories",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/download": {
                "get": {
                  "description": "Returns the raw file body, not JSON. Directories cannot be downloaded.",
                  "operationId": "downloadFile",
                  "parameters": [
                    {
                      "description": "Site-relative file path.",
                      "in": "query",
                      "name": "path",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "*/*": {
                          "schema": {
                            "format": "binary",
                            "type": "string"
                          }
                        }
                      },
                      "description": "Raw file content. Content type is inferred from the filename.",
                      "headers": {
                        "Cache-Control": {
                          "example": "private, no-store",
                          "schema": {
                            "type": "string"
                          }
                        },
                        "Content-Length": {
                          "description": "Download size in bytes.",
                          "schema": {
                            "type": "integer"
                          }
                        },
                        "ETag": {
                          "description": "SHA-1 hash of the file.",
                          "schema": {
                            "type": "string"
                          }
                        },
                        "Last-Modified": {
                          "schema": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                      "$ref": "#/components/responses/NotFound"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    }
                  ],
                  "summary": "Download a file",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/info": {
                "get": {
                  "description": "Supplying sitename returns public information without authentication. Omit sitename to retrieve information about the authenticated site.",
                  "operationId": "getSiteInfo",
                  "parameters": [
                    {
                      "description": "Public site name. Without this parameter, bearer credentials identify the site.",
                      "in": "query",
                      "name": "sitename",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "properties": {
                              "info": {
                                "$ref": "#/components/schemas/SiteInfo"
                              },
                              "result": {
                                "const": "success"
                              }
                            },
                            "required": [
                              "result",
                              "info"
                            ],
                            "type": "object"
                          }
                        }
                      },
                      "description": "Site information."
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                      "$ref": "#/components/responses/NotFound"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    },
                    {}
                  ],
                  "summary": "Get site information",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/list": {
                "get": {
                  "description": "Without path, lists the entire site recursively. With path, lists that directory's immediate children.",
                  "operationId": "listFiles",
                  "parameters": [
                    {
                      "description": "Directory to list. Omit, leave blank, or use / to list the entire site.",
                      "in": "query",
                      "name": "path",
                      "required": false,
                      "schema": {
                        "type": "string"
                      }
                    }
                  ],
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "properties": {
                              "files": {
                                "items": {
                                  "oneOf": [
                                    {
                                      "$ref": "#/components/schemas/DirectoryEntry"
                                    },
                                    {
                                      "$ref": "#/components/schemas/FileEntry"
                                    }
                                  ]
                                },
                                "type": "array"
                              },
                              "result": {
                                "const": "success"
                              }
                            },
                            "required": [
                              "result",
                              "files"
                            ],
                            "type": "object"
                          }
                        }
                      },
                      "description": "Site entries."
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    }
                  ],
                  "summary": "List files and directories",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/rename": {
                "post": {
                  "description": "The destination parent directory must already exist, and an existing destination cannot be overwritten.",
                  "operationId": "renamePath",
                  "requestBody": {
                    "content": {
                      "application/x-www-form-urlencoded": {
                        "schema": {
                          "properties": {
                            "new_path": {
                              "description": "New site-relative path.",
                              "type": "string"
                            },
                            "path": {
                              "description": "Current site-relative path.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "path",
                            "new_path"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/MessageResponse"
                          }
                        }
                      },
                      "description": "Path renamed or moved."
                    },
                    "400": {
                      "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                      "$ref": "#/components/responses/Forbidden"
                    }
                  },
                  "security": [
                    {
                      "bearerAuth": []
                    }
                  ],
                  "summary": "Rename or move a file or directory",
                  "tags": [
                    "Sites"
                  ]
                }
              },
              "/api/upload": {
                "post": {
