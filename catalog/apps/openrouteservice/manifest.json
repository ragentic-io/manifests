  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "openrouteservice"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.heigit.org/openrouteservice",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "parameters": {
                "profile": {
                  "description": "Routing profile, such as driving-car or foot-walking.",
                  "in": "path",
                  "name": "profile",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              },
              "schemas": {
                "Coordinate": {
                  "description": "Longitude and latitude, in that order.",
                  "items": false,
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "Coordinates": {
                  "items": {
                    "$ref": "#/components/schemas/Coordinate"
                  },
                  "type": "array"
                },
                "DirectionsRequest": {
                  "additionalProperties": true,
                  "properties": {
                    "coordinates": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Coordinates"
                        }
                      ],
                      "description": "Ordered coordinate pairs for the route.",
                      "minItems": 2
                    }
                  },
                  "required": [
                    "coordinates"
                  ],
                  "type": "object"
                },
                "DirectionsResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "bbox": {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "routes": {
                      "items": {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "FeatureCollection": {
                  "additionalProperties": true,
                  "properties": {
                    "bbox": {
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "features": {
                      "items": {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "type": {
                      "const": "FeatureCollection"
                    }
                  },
                  "type": "object"
                },
                "IsochronesRequest": {
                  "additionalProperties": true,
                  "properties": {
                    "interval": {
                      "description": "Interval used to segment an isochrone range.",
                      "type": "integer"
                    },
                    "locations": {
                      "$ref": "#/components/schemas/Coordinates"
                    },
                    "range": {
                      "description": "Exact distance or time ranges for the requested isochrones.",
                      "items": {
                        "type": "number"
                      },
                      "type": "array"
                    },
                    "range_type": {
                      "enum": [
                        "time",
                        "distance"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "locations",
                    "range"
                  ],
                  "type": "object"
                },
                "MatrixRequest": {
                  "additionalProperties": true,
                  "properties": {
                    "destinations": {
                      "description": "Location indexes to use as destinations; omitted means all locations.",
                      "items": {
                        "oneOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "pattern": "^\\d+$",
                            "type": "string"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "locations": {
                      "$ref": "#/components/schemas/Coordinates"
                    },
                    "metrics": {
                      "items": {
                        "enum": [
                          "duration",
                          "distance"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "sources": {
                      "description": "Location indexes to use as sources; omitted means all locations.",
                      "items": {
                        "oneOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "pattern": "^\\d+$",
                            "type": "string"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "units": {
                      "description": "Unit for returned distances; durations are in seconds.",
                      "enum": [
                        "m",
                        "km",
                        "mi"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "locations"
                  ],
                  "type": "object"
                },
                "MatrixResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "distances": {
                      "$ref": "#/components/schemas/NumberMatrix"
                    },
                    "durations": {
                      "$ref": "#/components/schemas/NumberMatrix"
                    }
                  },
                  "type": "object"
                },
                "NumberMatrix": {
                  "items": {
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "SnapRequest": {
                  "additionalProperties": true,
                  "properties": {
                    "id": {
                      "description": "Optional request identifier echoed in response metadata.",
                      "type": "string"
                    },
                    "locations": {
                      "$ref": "#/components/schemas/Coordinates"
                    },
                    "radius": {
                      "description": "Maximum search radius in meters.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "locations",
                    "radius"
                  ],
                  "type": "object"
                },
                "SnapResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "locations": {
                      "items": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "$ref": "#/components/schemas/SnappedLocation"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "SnappedLocation": {
                  "additionalProperties": true,
                  "properties": {
                    "location": {
                      "$ref": "#/components/schemas/Coordinate"
                    },
                    "name": {
                      "type": "string"
                    },
                    "snapped_distance": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                }
              },
              "securitySchemes": {
                "apiKey": {
                  "description": "Send the API key directly; do not prefix it with Bearer.",
                  "in": "header",
                  "name": "Authorization",
                  "type": "apiKey"
                }
              }
            },
            "externalDocs": {
              "description": "Official OpenRouteService API reference",
              "url": "https://giscience.github.io/openrouteservice/api-reference/"
            },
            "info": {
              "description": "Community-maintained subset of the public OpenRouteService API, derived from the provider's API reference and interactive API documentation. Requests require an API key; send the key directly in the Authorization header.",
              "title": "OpenRouteService Core API",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/v2/directions/{profile}": {
                "parameters": [
                  {
                    "$ref": "#/components/parameters/profile"
                  }
                ],
                "post": {
                  "description": "The default POST response is JSON.",
                  "operationId": "calculateDirectionsJson",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/DirectionsRequest"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/DirectionsResponse"
                          }
                        }
                      },
                      "description": "Route response with route geometry and metadata."
                    }
                  },
                  "summary": "Calculate directions as JSON",
                  "tags": [
                    "Directions"
                  ]
                }
