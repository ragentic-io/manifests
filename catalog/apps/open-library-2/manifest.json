                      "type": "array"
                    },
                    "numFound": {
                      "type": "integer"
                    },
                    "num_found": {
                      "type": "integer"
                    },
                    "start": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "externalDocs": {
              "description": "Open Library API documentation and usage guidelines",
              "url": "https://openlibrary.org/developers/api"
            },
            "info": {
              "description": "Community-maintained description of documented, public read-only search and\nbook lookup endpoints. Open Library asks clients to make useful requests\nfor human users, cache responses, and identify applications with a\nUser-Agent containing contact information. Unidentified clients are limited\nto 1 request per second; identified clients to 3 requests per second.\nThese APIs are not intended as data backends for third-party services or\nfor bulk/high-traffic commercial infrastructure; use the monthly data dumps\nfor bulk access.",
              "title": "Open Library Web API",
              "version": "1.0.0"
            },
