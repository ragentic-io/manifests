                "get": {
                  "description": "Searches the datascan category by default. Queries without a historical time filter search the last 30 days. The Search API returns at most 10,000 results; larger exports require a higher-tier Export API.",
                  "operationId": "searchOnyphe",
                  "parameters": [
                    {
                      "description": "ONYPHE Query Language expression.",
                      "example": "domain:example.com protocol:ssh",
                      "in": "query",
                      "name": "q",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    },
                    {
                      "description": "Page number to retrieve.",
                      "in": "query",
                      "name": "page",
                      "schema": {
                        "default": 1,
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Maximum number of results for a page; account limits may be lower.",
                      "in": "query",
                      "name": "size",
                      "schema": {
                        "default": 100,
                        "maximum": 10000,
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    {
                      "description": "Include the OQL query that matched each result.",
                      "in": "query",
                      "name": "trackquery",
                      "schema": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    {
                      "description": "Include calculated fields such as defanged and undefanged URLs.",
                      "in": "query",
