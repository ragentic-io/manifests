  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "graphjson"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.graphjson.com",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "responses": {
                "BadRequest": {
                  "content": {
                    "application/json": {
                      "example": {
                        "error": "Invalid API KEY"
                      },
                      "schema": {
                        "$ref": "#/components/schemas/ErrorResponse"
                      }
                    },
                    "text/plain": {
                      "schema": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "Invalid method, key, payload, timestamp, range, filter, or query."
                },
                "IngestionAccepted": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "additionalProperties": true,
                        "type": "object"
                      }
                    }
                  },
                  "description": "Request accepted. Do not depend on undocumented success-body fields."
                },
                "InternalError": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ErrorResponse"
                      }
                    },
                    "text/plain": {
                      "schema": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "Internal ingestion failure. Retry a bounded number of times."
                },
                "TooManyRequests": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ErrorResponse"
                      }
                    },
                    "text/plain": {
                      "example": "Too Many Requests",
                      "schema": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "Ingestion request guardrail exceeded. Retry with exponential backoff and jitter."
                }
              },
              "schemas": {
                "ApiKey": {
                  "description": "Secret workspace API key. Keep server-side.",
                  "minLength": 1,
                  "type": "string"
                },
                "BulkLogRequest": {
                  "additionalProperties": false,
                  "properties": {
                    "api_key": {
                      "$ref": "#/components/schemas/ApiKey"
                    },
                    "collection": {
                      "$ref": "#/components/schemas/CollectionName"
                    },
                    "jsons": {
                      "description": "Must contain one entry for every item in timestamps.",
                      "items": {
                        "$ref": "#/components/schemas/SerializedEvent"
                      },
                      "maxItems": 50,
                      "minItems": 1,
                      "type": "array"
                    },
                    "no_flatten": {
                      "default": false,
                      "description": "Preserve nested JSON when true.",
                      "type": "boolean"
                    },
                    "timestamps": {
                      "description": "Must contain one entry for every item in jsons.",
                      "items": {
                        "$ref": "#/components/schemas/UnixTimestamp"
                      },
                      "maxItems": 50,
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "api_key",
                    "timestamps",
                    "jsons"
                  ],
                  "type": "object"
                },
                "CollectionName": {
                  "examples": [
                    "product_events"
                  ],
                  "minLength": 1,
                  "type": "string"
                },
                "DataResponse": {
                  "additionalProperties": true,
                  "description": "Stable Data API envelope. The row shape depends on the requested graph type and SQL column mapping; see the named row schemas and the Data API response-contract guide.",
                  "properties": {
                    "compare_result": {
                      "description": "Comparison rows when the request uses a comparison graph or comparison window.",
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/TimeSeriesRow"
                          },
                          {
                            "$ref": "#/components/schemas/LabelValueRow"
                          },
                          {
                            "$ref": "#/components/schemas/TableRow"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "description": "Query-derived totals, resolved granularity, and other shape-specific metadata.",
                      "type": "object"
                    },
                    "result": {
                      "items": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/SampleRow"
                          },
                          {
                            "$ref": "#/components/schemas/TimeSeriesRow"
                          },
                          {
                            "$ref": "#/components/schemas/LabelValueRow"
                          },
                          {
                            "$ref": "#/components/schemas/TableRow"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "telemetry": {
                      "additionalProperties": true,
                      "description": "Optional query execution telemetry. Treat additional telemetry fields as additive.",
                      "type": "object"
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "type": "object"
                },
                "EmbedResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "iframe_url": {
                      "description": "Opaque bearer URL for the generated iframe.",
                      "format": "uri",
                      "type": "string"
                    },
                    "image_url": {
                      "description": "Opaque bearer URL for the generated image.",
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "iframe_url",
                    "image_url"
                  ],
                  "type": "object"
                },
                "ErrorResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "error": {
                      "description": "Human-readable error. Wording can evolve.",
                      "type": [
                        "string",
                        "object",
                        "array",
                        "null"
                      ]
                    }
                  },
                  "type": "object"
                },
                "FilterCondition": {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "description": "Field name.",
                      "type": "string"
                    },
                    {
                      "enum": [
                        "=",
                        "≠",
                        "includes",
                        "excludes",
                        ">",
                        "<"
                      ],
                      "type": "string"
                    },
                    {
                      "description": "Comparison value.",
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  ],
                  "type": "array"
                },
                "FilterList": {
                  "description": "A flat AND list of conditions or nested OR groups of AND conditions.",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/FilterCondition"
                      },
                      {
                        "items": {
                          "$ref": "#/components/schemas/FilterCondition"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "type": "array"
                },
                "IframeResponse": {
                  "additionalProperties": true,
                  "properties": {
                    "url": {
                      "description": "Opaque bearer URL for the generated iframe.",
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "required": [
                    "url"
                  ],
                  "type": "object"
                },
                "LabelValueRow": {
                  "additionalProperties": true,
                  "description": "One label/value aggregate used by categorical and mapped SQL visualizations.",
                  "properties": {
                    "label": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "type": "object"
                },
                "LogEventRequest": {
                  "additionalProperties": false,
                  "properties": {
                    "api_key": {
                      "$ref": "#/components/schemas/ApiKey"
                    },
                    "collection": {
                      "$ref": "#/components/schemas/CollectionName"
                    },
                    "json": {
                      "$ref": "#/components/schemas/SerializedEvent"
                    },
                    "no_flatten": {
                      "default": false,
                      "description": "Preserve nested JSON when true.",
                      "type": "boolean"
                    },
                    "timestamp": {
                      "$ref": "#/components/schemas/UnixTimestamp"
                    }
                  },
                  "required": [
                    "api_key",
                    "json"
                  ],
                  "type": "object"
                },
                "SampleRow": {
                  "additionalProperties": true,
                  "description": "One Samples result with the original event time and parsed JSON payload.",
                  "properties": {
                    "json": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "timestamp": {
                      "description": "Event time as a Unix second.",
                      "type": "number"
                    }
                  },
                  "required": [
                    "timestamp",
                    "json"
                  ],
                  "type": "object"
                },
                "SerializedEvent": {
                  "description": "A serialized JSON object. Top-level arrays are not accepted.",
                  "examples": [
                    "{\"event\":\"signup_completed\",\"event_id\":\"evt_01J...\"}"
                  ],
                  "maxLength": 10000,
                  "minLength": 2,
                  "type": "string"
                },
                "TableRow": {
                  "additionalProperties": true,
                  "description": "A table or SQL row whose keys come from the selected fields or query aliases.",
                  "type": "object"
                },
                "TimeSeriesRow": {
                  "additionalProperties": true,
                  "description": "One resolved time bucket. Numeric value keys depend on the aggregation, metric, and split.",
                  "properties": {
                    "timestamp": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  "required": [
                    "timestamp"
                  ],
                  "type": "object"
                },
                "UnixTimestamp": {
                  "description": "Whole Unix seconds.",
                  "examples": [
                    1785081600
                  ],
                  "type": "integer"
                },
                "VisualizationRequest": {
                  "additionalProperties": true,
                  "anyOf": [
                    {
                      "required": [
                        "start",
                        "end"
                      ],
                      "title": "Collection visualizer request"
                    },
                    {
                      "required": [
                        "sql_query"
                      ],
                      "title": "SQL visualization request"
                    }
                  ],
                  "properties": {
                    "IANA_time_zone": {
                      "default": "America/Los_Angeles",
                      "examples": [
                        "UTC",
                        "America/Los_Angeles"
                      ],
                      "type": "string"
                    },
                    "aggregation": {
                      "examples": [
                        "Count",
                        "Sum",
                        "Avg"
                      ],
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "api_key": {
                      "$ref": "#/components/schemas/ApiKey"
                    },
                    "collection": {
                      "$ref": "#/components/schemas/CollectionName"
                    },
                    "compare": {
                      "examples": [
                        "30 days ago"
                      ],
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "compare_filters": {
                      "$ref": "#/components/schemas/FilterList"
                    },
                    "customizations": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "denominator_filters": {
                      "$ref": "#/components/schemas/FilterList"
                    },
                    "end": {
                      "oneOf": [
                        {
                          "examples": [
                            "now"
                          ],
                          "type": "string"
                        },
                        {
                          "$ref": "#/components/schemas/UnixTimestamp"
                        }
                      ]
                    },
                    "filters": {
                      "$ref": "#/components/schemas/FilterList"
                    },
                    "granularity": {
                      "enum": [
                        "Auto",
                        "Minute",
                        "Hour",
                        "Day",
                        "Week",
                        "Month"
                      ],
                      "type": "string"
                    },
                    "graph_type": {
                      "enum": [
                        "Samples",
                        "Single Line",
                        "Multi Line",
                        "Stacked Line",
                        "Cumulative Line",
                        "Ratio Line",
                        "Compare Line",
                        "Single Value",
                        "Table",
                        "Bar Chart",
                        "Pie Chart",
                        "Funnel"
                      ],
                      "type": "string"
                    },
                    "label_column": {
                      "type": "string"
                    },
                    "metric": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "numerator_filters": {
                      "$ref": "#/components/schemas/FilterList"
                    },
                    "order": {
                      "enum": [
                        "Ascending",
                        "Descending"
                      ],
                      "type": "string"
                    },
                    "split": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "split_column": {
                      "type": "string"
                    },
                    "sql_query": {
                      "description": "Read-only saved-style SQL query.",
                      "type": "string"
                    },
                    "start": {
                      "oneOf": [
                        {
                          "examples": [
                            "30 days ago"
                          ],
