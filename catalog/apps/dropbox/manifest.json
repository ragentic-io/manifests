  "kind": "bundle",
  "manifest": {
    "apiVersion": "ragentic.dev/v1",
    "kind": "ConnectorTemplate",
    "metadata": {
      "name": "dropbox"
    },
    "spec": {
      "base": {
        "endpoint": "https://api.dropboxapi.com",
        "protocol": "openapi",
        "specification": {
          "document": {
            "components": {
              "schemas": {
                "ListFolderResult": {
                  "properties": {
                    "cursor": {
                      "type": "string"
                    },
                    "entries": {
                      "items": {
                        "$ref": "#/components/schemas/Metadata"
                      },
                      "type": "array"
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "entries",
                    "cursor",
                    "has_more"
                  ],
                  "type": "object"
                },
                "Metadata": {
                  "additionalProperties": true,
                  "properties": {
                    ".tag": {
                      "enum": [
                        "file",
                        "folder",
                        "deleted"
                      ],
                      "type": "string"
                    },
                    "client_modified": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "path_display": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "path_lower": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "rev": {
                      "type": "string"
                    },
                    "server_modified": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "size": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    ".tag",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "securitySchemes": {
                "DropboxToken": {
                  "description": "Dropbox OAuth 2.0 access token.",
                  "scheme": "bearer",
                  "type": "http"
                }
              }
            },
            "info": {
              "description": "Community-maintained definition for listing folders, continuing folder listings, and retrieving file or folder metadata. Other Files API operations are intentionally outside this focused specification.",
              "externalDocs": {
                "description": "Dropbox HTTP API documentation",
                "url": "https://www.dropbox.com/developers/documentation/http/documentation"
              },
              "title": "Dropbox Files API (focused)",
              "version": "1.0.0"
            },
            "openapi": "3.1.0",
            "paths": {
              "/2/files/get_metadata": {
                "post": {
                  "description": "The root folder is not supported by this operation.",
                  "externalDocs": {
                    "url": "https://www.dropbox.com/developers/documentation/http/documentation#files-get_metadata"
                  },
                  "operationId": "getMetadata",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "properties": {
                            "path": {
                              "description": "Dropbox path, file ID, or revision.",
                              "type": "string"
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/Metadata"
                          }
                        }
                      },
                      "description": "Metadata for a file, folder, or deleted entry."
                    }
                  },
                  "summary": "Get file or folder metadata"
                }
              },
              "/2/files/list_folder": {
                "post": {
                  "description": "Returns the files and direct subfolders in a folder. An empty path lists the root. When has_more is true, pass the returned cursor to list_folder/continue.",
                  "externalDocs": {
                    "url": "https://www.dropbox.com/developers/documentation/http/documentation#files-list_folder"
                  },
                  "operationId": "listFolder",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "properties": {
                            "include_deleted": {
                              "default": false,
                              "type": "boolean"
                            },
                            "path": {
                              "description": "Dropbox path, file ID, or empty string for the root folder.",
                              "type": "string"
                            },
                            "recursive": {
                              "default": false,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/ListFolderResult"
                          }
                        }
                      },
                      "description": "Folder entries and a cursor for retrieving additional entries."
                    }
                  },
                  "summary": "List a folder"
                }
              },
              "/2/files/list_folder/continue": {
                "post": {
                  "description": "Returns the next page of entries for a previously returned cursor.",
                  "externalDocs": {
                    "url": "https://www.dropbox.com/developers/documentation/http/documentation#files-list_folder-continue"
                  },
                  "operationId": "continueListFolder",
                  "requestBody": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "properties": {
                            "cursor": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "cursor"
                          ],
                          "type": "object"
                        }
                      }
                    },
                    "required": true
                  },
                  "responses": {
                    "200": {
                      "content": {
                        "application/json": {
                          "schema": {
                            "$ref": "#/components/schemas/ListFolderResult"
                          }
                        }
                      },
                      "description": "Folder entries and an updated cursor."
                    }
                  },
                  "summary": "Continue a folder listing"
                }
              }
            },
            "security": [
              {
                "DropboxToken": []
              }
            ],
            "servers": [
              {
                "url": "https://api.dropboxapi.com"
              }
            ]
          }
        },
        "type": "app"
      },
      "category": "app",
      "connector": {},
      "status": "draft",
      "title": "Dropbox"
    }
